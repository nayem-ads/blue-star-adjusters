{
  "headers": [
    { "source": "_astro/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "**/*.@(mp4|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "@(robots.txt|sitemap.xml|sitemap-index.xml|llms.txt|llms-full.txt)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
