---
// Inline icon from the Figma icon set (public/svg/icons, stroke = currentColor, 1.5px on 24 grid).
// Usage: <Icon name="phone" size={20} class="text-royal" />
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = '', label } = Astro.props;
const all = import.meta.glob('/public/svg/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = all[`/public/svg/icons/${name}.svg`];
if (!raw) throw new Error(`Icon: unknown icon ${name}`);
const svg = raw.replace('<svg ', `<svg class="${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'} `)
  .replace(/width="24" height="24"/, `width="${size}" height="${size}"`);
---
<Fragment set:html={svg} />
