---
// Who We Are (Figma desktop 128:3436, mobile 128:6353). Indexable.
// data-node = desktop node id, data-node-m = mobile node id (pixel-diff --mobile swaps them).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallBar from '../../components/CallBar.astro';
import Hero from '../../sections/who-we-are/Hero.astro';
import WhyNewFirm from '../../sections/who-we-are/WhyNewFirm.astro';
import NewWay from '../../sections/who-we-are/NewWay.astro';
import Bento from '../../sections/who-we-are/Bento.astro';
import NoConflict from '../../sections/who-we-are/NoConflict.astro';
import Founder from '../../sections/who-we-are/Founder.astro';
import Results from '../../sections/who-we-are/Results.astro';
import KitTable from '../../sections/kit/KitTable.astro';
import KitFaq from '../../sections/kit/KitFaq.astro';
import KitProse from '../../sections/kit/KitProse.astro';
import WhereWeWork from '../../sections/who-we-are/WhereWeWork.astro';
import FinalCta from '../../sections/who-we-are/FinalCta.astro';
const title = 'Public Adjusting Firm in Sacramento | Blue Star Adjusters';
const description = 'Blue Star Adjusters is a licensed public adjusting firm in Sacramento. A senior adjuster leads every claim. See all six firm licenses and check each one.';
const licenseRows = [
  ['California', '6015234', '[California Department of Insurance license search](https://cdicloud.insurance.ca.gov/cal/LicenseNumberSearch)'],
  ['Nevada', '4263596', '[Nevada Division of Insurance license search](https://di.nv.gov/nv/r/doi/licensing/search)'],
  ['Oregon', '3004448214', '[Oregon Division of Financial Regulation, check a license](https://dfr.oregon.gov/help/complaints-licenses/Pages/check-license.aspx)'],
  ['Colorado', '969283', '[Colorado Division of Insurance, verify a license](https://doi.colorado.gov/for-consumers/consumer-protection)'],
  ['Washington', '1382428', '[Washington Office of the Insurance Commissioner lookup](https://www.insurance.wa.gov/consumertoolkit/search.aspx)'],
  ['Arizona', '3004469742', '[Arizona Department of Insurance and Financial Institutions license search](https://difi.az.gov/license-search)'],
];
const faq = [
  { q: 'Is Blue Star Adjusters licensed in California?', a: 'Yes. Our California firm license is CA DOI License No. 6015234, held by Blue Star Adjusters LLC. You can enter that number in the California Department of Insurance license search and see it yourself.' },
  { q: "How do I check a public adjuster's license?", a: "Use the state regulator's lookup, not the adjuster's own website. In California, the Department of Insurance license search takes a license number. Every one of our six firm licenses is in the table above, next to the lookup for its state." },
  { q: 'Who will work on my claim?', a: 'A senior adjuster leads every claim, from the first call to the final settlement. Building estimators, inventory specialists and accountants work under that adjuster. The adjuster who walks your property is the one who negotiates it.' },
  { q: 'Do you work for my insurance company?', a: 'No. We represent the insured only. The adjuster your insurer sends works for the insurance company. You always have final say on any settlement.' },
  { q: 'How are you paid?', a: "No upfront cost. We're paid a percentage of what we recover. In California, our fee can never leave you with less than your insurer had already paid before you hired us. The free review costs nothing." },
  { q: 'Can I cancel after I sign?', a: 'In California, yes. You can cancel within three business days of signing and receiving the contract, or within five calendar days in a declared catastrophic disaster area.' },
];
---
<Base title={title} description={description}>
  <div data-node="128:3437" data-node-m="128:6354"><Header theme="light" /></div>
  <main class="bs-wwa">
    <Hero />
    <WhyNewFirm />
    <NewWay />
    <Bento />
    <NoConflict />
    <Founder />
    <Results />
    <KitTable chip="07" id="wwa-licenses" bg="paper" title="Licensed Public Adjusters in California and Five More States." intro="Blue Star Adjusters LLC holds a public adjusting firm license in six states. Don't take our word for it. Check each number with the state regulator. Some lookups search by license number, others by the name Blue Star Adjusters." head={['State', 'Firm license No.', 'Check it with the regulator']} rows={licenseRows} note="Blue Star Adjusters is a member of PCAPIA." />
    <WhereWeWork />
    <KitFaq chip="09" id="wwa-faq" bg="paper" title="Questions About Our Public Adjusting Firm in Sacramento" items={faq} />
    <KitProse chip="10" id="wwa-related" bg="white" title="Related" list={['[How a public adjuster works on your claim](/how-it-works/)', '[Why homeowners choose Blue Star](/why-blue-star/)', '[Who we serve](/who-we-serve/)', '[Public adjuster fees, explained](/fees/)']} />
    <FinalCta />
  </main>
  <div data-node="128:5583" data-node-m="135:4596"><Footer /></div>
  <CallBar />
</Base>
<style is:global>
  /* Below lg, Chrome sets Montserrat/Schibsted text 1px higher than Figma (baseline rounding): nudge glyphs down 1px. */
  @media (max-width: 1023.98px) {
    .bs-wwa :where(.tm-body, .tm-body-strong, .tm-lead, .tm-h2, .tm-h3, .tm-display, .bs-wnudge):not(.bs-nonudge) { translate: 0 1px; }
  }
</style>
