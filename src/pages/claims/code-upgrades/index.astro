---
// Code Upgrades (Figma desktop 238:1616, mobile 238:2024). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import Related from '../../../sections/claims/Related.astro';
import Cta from '../../../sections/claims/Cta.astro';
import Button from '../../../components/Button.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Chip from '../../../sections/claims/Chip.astro';
import { dn } from '../../../sections/claims/nodes';
import { ROUTES } from '../../../data/site';
import Requires from '../../../sections/claims/code/Requires.astro';
import { page, hero, heroLead, requires, founder, related, cta } from '../../../data/claims/code-upgrades';
const { line, ...split } = founder;
const fn = line.nodes;
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-code">
    <Hero {...hero} />
    <Requires heroLead={heroLead} {...requires} />
    <PhotoSplit {...split}>
      <div slot="details" class="mx-[20px] lg:mx-0 flex flex-col items-start gap-[16px] lg:gap-[24px] pb-[40px] lg:pb-[56px]" {...dn(fn.block)}>
        <Chip theme="dark" node={fn.chip} text={fn.chipText}>{line.chip}</Chip>
        <span aria-hidden="true" class="block w-[40px] h-[4px] bg-white lg:w-[48px]" {...dn(fn.rule)}></span>
        <p class="m-0 tm-h3 lg:t-h3 text-white" {...dn(fn.body)}>{line.body}</p>
        <Button href={ROUTES.freeClaimReview} variant="on-dark" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]" data-node={fn.button[0]} data-node-m={fn.button[1]}>Schedule a Free Review</Button>
      </div>
    </PhotoSplit>
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) {
    .bs-code :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display,.bs-code-h1){position:relative;top:1px}
    .bs-code-h1 { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 44px; letter-spacing: -0.025em; }
  }
</style>
