---
// Commercial Claims (Figma desktop 230:10208, mobile 230:10616). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import Cta from '../../../sections/claims/Cta.astro';
import Scope from '../../../sections/claims/commercial/Scope.astro';
import List from '../../../sections/claims/commercial/List.astro';
import Index from '../../../sections/claims/commercial/Index.astro';
import Proof from '../../../sections/claims/commercial/Proof.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import { page, hero, scope, businessIncome, contingent, tenant, equipment, code, proof, attorney, notFor, faq, cta } from '../../../data/claims/commercial';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-commercial bs-fit">
    <Hero {...hero} />
    <Scope {...scope} />
    <List />
    <KitProse {...businessIncome} />
    <KitProse {...contingent} />
    <KitProse {...tenant} />
    <KitProse {...equipment} />
    <KitProse {...code} />
    <Proof {...proof} />
    <KitProse {...attorney} />
    <KitProse {...notFor} />
    <KitFaq {...faq} />
    <Index />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-commercial :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display,.bs-cm-h1){position:relative;top:1px} }
  /* Mobile hero: the longer H1 and the direct answer lead need the content to start under the header, on the photo ramp. */
  @media (max-width: 1023.98px) { .bs-commercial .bs-chero > .relative { padding-top: 300px; } }
  .bs-cm-h1 { font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 42px; letter-spacing: -0.025em; }
</style>
