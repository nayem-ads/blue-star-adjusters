---
// Denied or Underpaid claims page (Figma desktop 238:10968, mobile 238:11376). data-node = desktop id, data-node-m = mobile id.
// Copy: /home/claude/bluestar-work/pages/denied-or-underpaid/content.md (2026-10-16). New blocks use the content kit.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import RailList from '../../../sections/claims/RailList.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Cta from '../../../sections/claims/Cta.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import Disclaimer from '../../../sections/claims/denied/Disclaimer.astro';
import Counsel from '../../../sections/claims/denied/Counsel.astro';
import Underpaid from '../../../sections/claims/denied/Underpaid.astro';
import Related from '../../../sections/claims/denied/Related.astro';
import { page, hero, firstSteps, questions, reasons, answer, underpaid, counsel, faq, related, cta } from '../../../data/claims/denied-or-underpaid';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-denied bs-fit">
    <Hero {...hero} />
    <KitProse {...firstSteps} body={[...firstSteps.body]} list={[...firstSteps.list]} />
    <RailList {...questions} />
    <KitProse {...reasons} body={[...reasons.body]} list={[...reasons.list]} />
    <PhotoSplit {...answer}><Disclaimer slot="block-0" /></PhotoSplit>
    <Underpaid {...underpaid} />
    <Counsel {...counsel} />
    <KitFaq {...faq} items={[...faq.items]} />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-denied :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display,.bs-den-h1){position:relative;top:1px} }
  /* Long H1 + direct answer make the mobile hero taller than its 844 frame: keep the content clear of the overlay header. */
  @media (max-width: 1023.98px) { .bs-denied .bs-chero__content { margin-top: 112px; } }
  .bs-den-h1 { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 44px; letter-spacing: -0.025em; }
</style>
