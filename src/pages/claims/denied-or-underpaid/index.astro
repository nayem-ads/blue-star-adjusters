---
// Denied or Underpaid claims page (Figma desktop 238:10968, mobile 238:11376). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import RailList from '../../../sections/claims/RailList.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Related from '../../../sections/claims/Related.astro';
import Cta from '../../../sections/claims/Cta.astro';
import Citation from '../../../sections/claims/denied/Citation.astro';
import Disclaimer from '../../../sections/claims/denied/Disclaimer.astro';
import Counsel from '../../../sections/claims/denied/Counsel.astro';
import { page, hero, questions, answer, related, cta } from '../../../data/claims/denied-or-underpaid';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-denied">
    <Hero {...hero} />
    <RailList {...questions}><Citation slot="item-3" /></RailList>
    <PhotoSplit {...answer}><Disclaimer slot="block-0" /></PhotoSplit>
    <Counsel />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-denied :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display){position:relative;top:1px} }
</style>
