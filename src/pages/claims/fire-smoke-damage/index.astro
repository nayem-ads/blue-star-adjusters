---
// Fire & Smoke claims page (Figma desktop 217:5733, mobile 217:13377). data-node = desktop id, data-node-m = mobile id.
// Approved copy rewrite 2026-10: page copies of RailList (Misses), LawDoc (Law) and Related live in sections/claims/fire-smoke/; new copy uses the content kit.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import Cta from '../../../sections/claims/Cta.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Misses from '../../../sections/claims/fire-smoke/Misses.astro';
import Law from '../../../sections/claims/fire-smoke/Law.astro';
import Results from '../../../sections/claims/fire-smoke/Results.astro';
import Related from '../../../sections/claims/fire-smoke/Related.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import {
  page, hero, misses, detail, law, results, related, cta,
  smokeCoverage, smokeQualifies, coverage, notCovered, denied, timeline, beforeAccept, whoHelps, notFor, faq,
} from '../../../data/claims/fire-smoke-damage';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-fire-smoke bs-fit">
    <Hero {...hero} />
    <Misses {...misses} />
    <PhotoSplit {...detail} />
    <KitProse {...smokeCoverage} bg="paper" />
    <KitProse {...smokeQualifies} bg="white" />
    <Law {...law} />
    <KitProse {...coverage} bg="white" />
    <KitProse {...notCovered} bg="paper" />
    <KitProse {...denied} bg="white" />
    <Results {...results} />
    <KitProse {...timeline} bg="white" />
    <KitProse {...beforeAccept} bg="paper" />
    <KitProse {...whoHelps} bg="white" />
    <KitProse {...notFor} bg="paper" />
    <KitFaq {...faq} bg="white" />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) {
    .bs-fire-smoke :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display,.bs-fs-h1){position:relative;top:1px}
    /* Approved H1 + direct answer are taller than the Figma hero: smaller mobile H1, content starts below the header. */
    .bs-fire-smoke .bs-fs-h1 { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 44px; letter-spacing: -0.025em; }
    .bs-fire-smoke .bs-chero > div.relative { padding-top: 240px; }
  }
</style>
