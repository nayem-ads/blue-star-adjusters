---
// Residential Claims (Figma desktop 226:698, mobile 226:1106). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import Cta from '../../../sections/claims/Cta.astro';
import Buckets from '../../../sections/residential/Buckets.astro';
import Index from '../../../sections/residential/Index.astro';
import Estimate from '../../../sections/residential/Estimate.astro';
import Results from '../../../sections/residential/Results.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import { page, hero, cta, depreciation, beforeSign, notFor, faq, related } from '../../../data/claims/residential';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-residential bs-fit">
    <Hero {...hero} />
    <Buckets />
    <Index />
    <Estimate />
    <Results />
    <KitProse {...depreciation} bg="paper" />
    <KitProse {...beforeSign} bg="white" />
    <KitProse {...notFor} bg="paper" />
    <KitFaq {...faq} bg="white" />
    <KitProse {...related} bg="paper" />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-residential :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display){position:relative;top:1px} }
  /* Keyword H1 + direct answer make the hero content taller than the bottom-anchored frame: keep it clear of the overlay header. */
  .bs-residential .bs-chero > div.relative { padding-top: 112px; }
  @media (min-width: 1024px) { .bs-residential .bs-chero > div.relative { padding-top: 128px; } }
</style>
