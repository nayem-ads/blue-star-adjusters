---
// Wildfire (Figma desktop 234:917, mobile 234:1325). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/Hero.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Related from '../../../sections/claims/Related.astro';
import Cta from '../../../sections/claims/Cta.astro';
import TwoClaims from '../../../sections/claims/wildfire/TwoClaims.astro';
import Rights from '../../../sections/claims/wildfire/Rights.astro';
import Market from '../../../sections/claims/wildfire/Market.astro';
import Timing from '../../../sections/claims/wildfire/Timing.astro';
import Button from '../../../components/Button.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import KitStyles from '../../../sections/kit/KitStyles.astro';
import { md } from '../../../sections/kit/md';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../../data/site';
import { page, hero, detail, related, cta, firstSteps, faq } from '../../../data/claims/wildfire';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-wildfire bs-fit">
    <Hero {...hero} />
    <TwoClaims />
    <KitProse chip="§ 02" id="wf-steps-title" title={firstSteps.title} list={firstSteps.list} after={firstSteps.after} bg="white" />
    <KitStyles />
    <PhotoSplit {...detail}>
      <p slot="block-0" class="m-0 w-full tm-body lg:t-body text-ink">Where the loss calls for it, we get structural review before any estimate assumes the foundation can stay.</p>
      <span slot="block-1" aria-hidden="true" class="block h-[24px] lg:h-[32px]"></span>
      <Fragment slot="block-2">
        <p class="m-0 w-full tm-body lg:t-body text-ink">Once you hit the dwelling limit, the other coverages have to carry the rebuild. Code upgrades. Extended replacement cost. Debris removal.</p>
        <p class="m-0 w-full tm-body lg:t-body text-ink">Don't assume you're underinsured before the loss is measured. Each coverage gets scoped on its own.</p>
        <p class="m-0 w-full tm-body lg:t-body text-ink" set:html={md(`[Ordinance or law coverage](${ROUTES.codeUpgrades})`)} />
        <div class="w-full lg:w-auto flex flex-col gap-[12px] pt-[8px] lg:flex-row lg:gap-[16px]">
          <Button href={ROUTES.freeClaimReview} variant="solid" class="h-[56px] w-full lg:h-[52px] lg:w-auto">Schedule a Free Review</Button>
          <Button href={PHONE_TEL} variant="outline" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto">Call {PHONE_DISPLAY}</Button>
        </div>
      </Fragment>
    </PhotoSplit>
    <Rights />
    <Market />
    <Timing />
    <KitFaq chip="§ 09" id="wf-faq-title" title={faq.title} items={faq.items} bg="white" />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  /* Mobile photo stack is 496 tall in Figma (kit default without a dimension line is 462). */
  @media (max-width: 1023.98px) { .bs-wildfire .bs-psplit > div:first-child { height: 496px; } }
  /* Hero carries the direct answer (lead): give the content room under the overlaid header. */
  .bs-wildfire .bs-chero > div.relative { padding-top: 112px; }
  @media (min-width: 1024px) { .bs-wildfire .bs-chero > div.relative { padding-top: 128px; } }
  @media (max-width: 1023.98px) { .bs-wildfire :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display){position:relative;top:1px} }
</style>
