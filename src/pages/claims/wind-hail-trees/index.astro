---
// Wind, Hail & Trees (Figma desktop 229:8926, mobile 229:9334). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Button from '../../../components/Button.astro';
import Hero from '../../../sections/claims/Hero.astro';
import PhotoSplit from '../../../sections/claims/PhotoSplit.astro';
import Related from '../../../sections/claims/Related.astro';
import Cta from '../../../sections/claims/Cta.astro';
import WindCollapse from '../../../sections/claims/wind/WindCollapse.astro';
import { ROUTES } from '../../../data/site';
import { page, hero, detail, related, cta } from '../../../data/claims/wind-hail-trees';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-wind bs-fit">
    <Hero {...hero} />
    <PhotoSplit {...detail}>
      <Button slot="block-1" href={ROUTES.freeClaimReview} class="h-[56px] w-full lg:h-[52px] lg:w-auto" node="229:9664" data-node-m="229:9816">Schedule a Free Review</Button>
    </PhotoSplit>
    <WindCollapse />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-wind :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display){position:relative;top:1px} }
</style>
