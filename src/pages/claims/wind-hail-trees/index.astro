---
// Wind, Hail & Trees (Figma desktop 229:8926, mobile 229:9334). data-node = desktop id, data-node-m = mobile id.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CallBar from '../../../components/CallBar.astro';
import Hero from '../../../sections/claims/wind/Hero.astro';
import Related from '../../../sections/claims/Related.astro';
import Cta from '../../../sections/claims/Cta.astro';
import KitProse from '../../../sections/kit/KitProse.astro';
import KitFaq from '../../../sections/kit/KitFaq.astro';
import StormDetail from '../../../sections/claims/wind/StormDetail.astro';
import WindCollapse from '../../../sections/claims/wind/WindCollapse.astro';
import Depreciation from '../../../sections/claims/wind/Depreciation.astro';
import { page, hero, related, cta, wearAndTear, misses, afterStorm, notFor, faq } from '../../../data/claims/wind-hail-trees';
---
<Base title={page.title} description={page.description}>
  <div class="absolute left-0 right-0 top-0 z-40" data-node={page.header[0]} data-node-m={page.header[1]}><Header theme="dark" overlay /></div>
  <main class="bs-wind bs-fit">
    <Hero {...hero} />
    <StormDetail />
    <WindCollapse />
    <KitProse {...wearAndTear} bg="paper" />
    <KitProse {...misses} bg="white" />
    <Depreciation />
    <KitProse {...afterStorm} bg="white" />
    <KitProse {...notFor} bg="paper" />
    <KitFaq {...faq} bg="white" />
    <Related {...related} />
    <Cta {...cta} />
  </main>
  <div data-node={page.footer[0]} data-node-m={page.footer[1]}><Footer /></div>
  <CallBar node={page.callBar} />
</Base>
<style is:global>
  @media (max-width: 1023.98px) {
    .bs-wind :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display,.bs-wind-h1){position:relative;top:1px}
    .bs-wind-h1 { font-family: var(--font-display); font-weight: 700; font-size: 38px; line-height: 42px; letter-spacing: -0.025em; }
  }
</style>
