---
// FAQ (Figma desktop 217:698, mobile 217:10753). data-node = desktop id, data-node-m = mobile id.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallBar from '../../components/CallBar.astro';
import Hero from '../../sections/faq/Hero.astro';
import Questions from '../../sections/faq/Questions.astro';
import FinalCta from '../../sections/faq/FinalCta.astro';
import Deadlines from '../../sections/faq/Deadlines.astro';
import KitProse from '../../sections/kit/KitProse.astro';
const deeper = [
  '[How a public adjuster works](/how-it-works/)',
  '[Public adjuster fees](/fees/)',
  '[Is a public adjuster worth it?](/why-blue-star/)',
  '[Denied or underpaid claims](/claims/denied-or-underpaid/)',
  '[The first 48 hours after a loss](/first-48-hours/)',
  '[Results](/results/)',
];
---
<Base title="When Is It Too Late to Hire a Public Adjuster? | Blue Star" description="Rarely, while your claim is open. See the deadlines that can make it too late, plus straight answers on public adjuster fees, timing and your rights.">
  <div data-node="217:699" data-node-m="217:10754"><Header theme="light" /></div>
  <main class="bs-faq bs-fit">
    <Hero />
    <Deadlines />
    <Questions />
    <KitProse id="faq-deeper" title="Go Deeper" list={deeper} bg="paper" />
    <FinalCta />
  </main>
  <div data-node="217:7806" data-node-m="217:11389"><Footer /></div>
  <CallBar node="217:11425" />
</Base>
<style is:global>
  @media (max-width: 1023.98px) { .bs-faq :where(.tm-body,.tm-body-strong,.tm-lead,.tm-h2,.tm-h3,.tm-display){position:relative;top:1px} }
</style>
