---
// Free Claim Review (Figma page 45:73): default 73:1379 / mobile 74:3862. Error state = forms.ts on an invalid
// submit (74:1785 / 74:4514). Thank-you state = ./thank-you.astro (74:2047 / 74:4725).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallBar from '../../components/CallBar.astro';
import FcrStyles from '../../sections/fcr/FcrStyles.astro';
import RequestSection from '../../sections/fcr/RequestSection.astro';
import NextSection from '../../sections/fcr/NextSection.astro';
import FeesSection from '../../sections/fcr/FeesSection.astro';
import Review from '../../sections/fcr/Review.astro';
import Faq from '../../sections/fcr/Faq.astro';
import Covers from '../../sections/fcr/Covers.astro';
import FinalCta from '../../sections/fcr/FinalCta.astro';
import KitProse from '../../sections/kit/KitProse.astro';
const title = 'Free Insurance Claim Review from Blue Star Adjusters';
const description = 'Free insurance claim review from a licensed public adjuster. No cost or obligation. Same business day callback, Monday to Friday, 9 AM to 5 PM Pacific.';
---
<Base title={title} description={description}>
  <FcrStyles />
  <div data-node="73:1380" data-node-m="74:3863"><Header theme="light" /></div>
  <main>
    <RequestSection />
    <NextSection />
    <Covers />
    <FeesSection />
    <Review />
    <Faq />
    <KitProse id="fcr-related" bg="paper" title="Related" list={[
      '[How a public adjuster works on your claim](/how-it-works/)',
      '[Public adjuster fees](/fees/)',
      '[Denied or underpaid claims](/claims/denied-or-underpaid/)',
      '[What to do in the first 48 hours](/first-48-hours/)',
    ]} />
    <FinalCta />
  </main>
  <div data-node="73:2865" data-node-m="74:4478"><Footer /></div>
  <CallBar />
</Base>

<script>
  import '../../sections/fcr/fcr-form.ts';
</script>
