---
// How It Works (Figma desktop 128:3750, mobile 135:4640). Indexable.
// data-node = desktop node id, data-node-m = mobile node id (QA swaps them for the 390 run).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CallBar from '../../components/CallBar.astro';
import Hero from '../../sections/how-it-works/Hero.astro';
import Steps from '../../sections/how-it-works/Steps.astro';
import WhoDoesWhat from '../../sections/how-it-works/WhoDoesWhat.astro';
import Contract from '../../sections/how-it-works/Contract.astro';
import BeforeYouCall from '../../sections/how-it-works/BeforeYouCall.astro';
import FinalCta from '../../sections/how-it-works/FinalCta.astro';
import KitTable from '../../sections/kit/KitTable.astro';
import KitProse from '../../sections/kit/KitProse.astro';
import KitFaq from '../../sections/kit/KitFaq.astro';
const title = 'How Does a Public Adjuster Work? 5 Steps | Blue Star';
const description = 'A public adjuster works for you, not your insurer. Five steps from free review to settlement, one senior adjuster, and you decide on every offer.';
---
<Base title={title} description={description}>
  <div class="hiw-hdr" data-node="128:3751" data-node-m="135:4641"><Header theme="light" /></div>
  <main class="bs-hiw">
    <Hero />
    <Steps />
    <WhoDoesWhat />
    <KitTable
      id="hiw-vs-title"
      bg="white"
      title="Public Adjuster, Insurance Company Adjuster or Attorney?"
      intro="All three can be part of a property claim. They work for different people."
      head={['', 'Insurance company adjuster', 'Public adjuster', 'Attorney']}
      rows={[
        ['Works for', 'The insurance company', 'You, the policyholder', 'You'],
        ['What they do', 'Inspects the loss and settles the claim for the insurer', 'Reads the policy, measures the loss, builds and negotiates the claim', 'Gives legal advice and takes a dispute to court'],
        ['How they’re paid', 'By the insurance company', 'No upfront cost. We’re paid a percentage of what we recover.', 'Set by your agreement with them'],
      ]}
      note="We don’t give legal advice. When a claim needs counsel, we work alongside your attorney."
    />
    <Contract />
    <KitProse
      id="hiw-license-title"
      bg="white"
      title="How to Check a Public Adjuster’s License"
      body={[
        'Public adjusters in California are licensed by the California Department of Insurance. Before you sign, look the license number up on the Department’s license search. Ours is CA DOI License No. 6015234.',
        '[Check a license with the California Department of Insurance](https://cdicloud.insurance.ca.gov/cal/LicenseNumberSearch)',
      ]}
    />
    <KitProse
      id="hiw-worth-title"
      bg="paper"
      title="When a Public Adjuster May Not Be Worth It"
      body={[
        'On a small loss, or when the carrier’s offer is already fair, our fee may outweigh what we add. We’ll tell you so at the free review, before you sign anything.',
        '[Is a public adjuster worth it?](/why-blue-star/)',
      ]}
    />
    <BeforeYouCall />
    <KitFaq
      id="hiw-faq-title"
      bg="paper"
      title="Questions About How a Public Adjuster Works"
      items={[
        { q: 'Does hiring a public adjuster slow the claim down?', a: 'It can. A 2010 Florida state study of claims at Citizens Property Insurance (OPPAGA Report 10-06) found that claims with a public adjuster took longer to settle than claims without one, and that the payments were higher before fees. More of the loss gets measured and argued, and that takes time.' },
        { q: 'Do I still talk to my insurer?', a: 'You can. Most clients prefer we handle it.' },
        { q: 'Will my insurer treat me differently?', a: 'Carriers work with public adjusters every day. The difference is what gets measured.' },
        { q: 'When should I call a public adjuster?', a: ['As early as you can. Bringing us in before the first estimate is final, and before anything is thrown away, gives us the most room to work. If you already have an offer, it’s usually not too late.', '[When is it too late to hire a public adjuster?](/faq/)'] },
      ]}
    />
    <FinalCta />
  </main>
  <div data-node="128:5982" data-node-m="146:1056"><Footer /></div>
  <CallBar />
</Base>
<style is:global>
  /* Figma v2 header instance shows the current page underlined (Header has the underline, transparent until hover). */
  /* 1024–1279: the layered 1280 layout (zigzag steps, rotated excerpt, hero row) doesn't fit, so scale the page body
     down in two steps instead of letting it overflow. Header and footer handle these widths themselves. */
  @media (min-width: 1024px) and (max-width: 1151.98px) { .bs-hiw { zoom: .8; } }
  @media (min-width: 1152px) and (max-width: 1279.98px) { .bs-hiw { zoom: .9; } }
  /* Below lg, Chrome sets the mobile text one pixel higher than Figma (baseline rounding). Nudge glyphs down 1px. */
  @media (max-width: 1023.98px) {
    .bs-hiw :where(.tm-body, .tm-body-strong, .tm-lead, .tm-h2, .tm-h3, .tm-display) { position: relative; top: 1px; }
  }
</style>
