---
// Home A (Figma Homepage v2: desktop 482:1321, mobile 482:2350). Indexable main homepage.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import Hero from '../sections/home-a/Hero.astro';
import Results from '../sections/home-a/Results.astro';
import WhyNow from '../sections/home-a/WhyNow.astro';
import ClaimsIndex from '../sections/home-a/ClaimsIndex.astro';
import Founder from '../sections/home-a/Founder.astro';
import WhoWeAre from '../sections/home-a/WhoWeAre.astro';
import ClaimTypes from '../sections/home-a/ClaimTypes.astro';
import Costs from '../sections/home-a/Costs.astro';
import KitFaq from '../sections/kit/KitFaq.astro';
import KitProse from '../sections/kit/KitProse.astro';
import WhoWeServe from '../sections/home-a/WhoWeServe.astro';
import Offices from '../sections/home-a/Offices.astro';
import FinalCta from '../sections/home-a/FinalCta.astro';
const title = 'Public Adjuster in California | Blue Star Adjusters';
const description = 'A public adjuster works for you, not your insurer. Blue Star measures the full loss and negotiates your claim. Licensed in California. No upfront cost.';
const faq = [
  { q: 'Why hire my own public adjuster when my insurance company already sent one?', a: 'Their adjuster works for the insurance company. A public adjuster is licensed to work only for you, the policyholder. We start from their estimate and measure what it left out.' },
  { q: 'Does a public adjuster slow the claim down?', a: 'It can. A 2010 Florida state study of claims filed at Citizens Property Insurance in 2008 and 2009 (OPPAGA Report 10-06) found that claims with a public adjuster took longer to settle than claims without one, and that the payments were higher before fees. More of the loss gets measured and argued, and that takes time.' },
  { q: 'When is it too late to hire a public adjuster?', a: ['Usually it isn’t, even with an offer in hand. We can reopen scope before you accept. The earlier we’re in, the more room we have to work.', '[When is it too late to hire a public adjuster?](/faq/)'] },
  { q: 'How do I check a public adjuster’s license in California?', a: 'Public adjusters in California are licensed by the California Department of Insurance. Before you sign, look the license number up on the Department’s license search. Ours is CA DOI License No. 6015234.' },
  { q: 'Will my insurer treat me differently if I hire one?', a: 'Carriers work with public adjusters every day. The difference is what gets measured.' },
  { q: 'Do you do the repairs?', a: 'No. We measure and negotiate. Your contractor builds.' },
];
const related = [
  '[Fire and smoke damage claims](/claims/fire-smoke-damage/)',
  '[Wildfire insurance claims](/claims/wildfire/)',
  '[Water damage claims](/claims/water-damage/)',
  '[Roof, hail and tree damage claims](/claims/wind-hail-trees/)',
  '[What to do after a house fire](/first-48-hours/)',
  '[Claim results](/results/)',
];
---
<Base title={title} description={description}>
  <div class="absolute top-0 left-0 right-0" data-node="53:74" data-node-m="58:468"><Header theme="dark" overlay={false} /></div>
  <main class="bs-home-a">
    <Hero />
    <Results />
    <ClaimsIndex />
    <WhyNow />
    <WhoWeServe />
    <Founder />
    <WhoWeAre />
    <ClaimTypes />
    <Costs />
    <Offices />
    <KitFaq id="home-faq" title="Questions About Hiring a Public Adjuster" items={faq} bg="paper" />
    <KitProse id="home-related" title="More on Property Insurance Claims" list={related} bg="white" />
    <FinalCta />
  </main>
  <div data-node="57:316" data-node-m="63:736"><Footer /></div>
  <CallBar />
</Base>

<style is:global>
  /* Chrome rounds Montserrat 16/26, 18/28 and the mobile Schibsted headings 1px higher than Figma
     (baseline rounding). Nudge those glyphs down 1px below lg; boxes are unchanged. Same fix as the other pages. */
  @media (max-width: 1023.98px) {
    .bs-home-a :where(.tm-body, .tm-body-strong, .tm-lead, .tm-h2, .tm-h3, .tm-display) { position: relative; top: 1px; }
  }
</style>
