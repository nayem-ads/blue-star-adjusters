---
// Claims kit / Hero (Fire & Smoke 217:5734 desktop 1280×820, 217:13378 mobile 390×844). Dark photo hero, content bottom-anchored.
// Usage: <Hero img={{d:'217:5735', m:'217:13379', alt:'…'}} eyebrow="Fire & Smoke" title={'Line one.\nLine two.'} nodes={…} />
// Optional: lead (640 wide, under the H1), leadOnMobile=false (page renders the lead in its next section, e.g. ALE/Code),
// titleM (mobile H1 text when it differs), caption=false (no "Field photograph"), bottom (desktop gap under content, default 96).
// nodes: every key is 'desktopId' or ['desktopId','mobileId'] (see NodeKeys below); pages pass their own ids so QA geometry is exact.
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Img from '../../components/Img.astro';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../data/site';
import { dn, d, m, type N } from './nodes';

type NodeKeys = 'section' | 'img' | 'overlay' | 'scrim' | 'content' | 'eyebrow' | 'title' | 'lead' | 'ctas' | 'cta1' | 'cta2'
  | 'trust' | 'trustRow' | 'trust1' | 'trust2' | 'trust3' | 'div1' | 'div2' | 'ruler' | 'caption' | 'captionText' | 'mScrim' | 'mRamp';
interface Props {
  img: { d: string; m: string; alt: string };
  eyebrow: string;
  title: string;
  titleM?: string;
  lead?: string;
  leadOnMobile?: boolean;
  caption?: boolean;
  captionM?: boolean;
  bottom?: number;
  nodes: Partial<Record<NodeKeys, N>>;
}
const { img, eyebrow, title, titleM, lead, leadOnMobile = true, caption = true, captionM = caption, bottom = 96, nodes: n } = Astro.props;
const trust = ['No upfront cost', 'You always have final say on any settlement', 'CA License No. 2B60428'];
const id = 'hero-title';
---
<section aria-labelledby={id} class="bs-chero relative overflow-hidden bg-ink" {...dn(n.section)}>
  <!-- Photo + scrims -->
  <div class="absolute inset-x-0 top-0 h-[520px] lg:hidden" data-node-m={m(n.img)}>
    <Img node={img.m} alt={img.alt} class="w-full h-full object-cover" priority />
  </div>
  <div class="absolute inset-0 hidden lg:block" data-node={d(n.img)}>
    <Img node={img.d} alt={img.alt} class="w-full h-full object-cover" priority />
  </div>
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[520px] bg-ink opacity-35 lg:hidden"></div>
  <div aria-hidden="true" class="bs-chero__ramp absolute inset-x-0 top-[264px] h-[264px] lg:hidden"></div>
  <div aria-hidden="true" class="absolute inset-0 hidden lg:block bg-ink opacity-50"></div>
  <div aria-hidden="true" class="absolute left-0 top-0 h-full w-[760px] hidden lg:block bg-ink opacity-60 blur-[60px]"></div>

  {captionM && <p class="lg:hidden absolute right-[20px] top-[84px] m-0 t-caption text-white" data-node-m={m(n.captionText)}>Field photograph</p>}

  <div class="relative max-w-[1280px] mx-auto min-h-[844px] lg:min-h-[820px] flex flex-col justify-end px-[20px] pb-[112px] lg:px-[80px] lg:pb-[var(--hb)]" style={`--hb:${bottom}px`}>
    <div class="bs-chero__content flex flex-col items-start gap-[24px] lg:gap-[32px] lg:w-[1040px]" {...dn(n.content)}>
      <div {...dn(n.eyebrow)}><Eyebrow theme="dark">{eyebrow}</Eyebrow></div>
      <h1 id={id} class="m-0 w-full tm-display lg:t-display-xl text-white whitespace-pre-line" {...dn(n.title)}>{titleM ? (<><span class="lg:hidden">{titleM}</span><span class="hidden lg:inline">{title}</span></>) : title}</h1>
      {lead && <p class:list={['m-0 tm-lead lg:t-lead text-white lg:w-[640px]', !leadOnMobile && 'hidden lg:block']} {...dn(n.lead)}>{lead}</p>}
      <!-- mobile: trust line sits above the buttons -->
      <div class="lg:hidden w-full flex flex-col items-start gap-[8px] text-white" data-node-m={m(n.trust)}>
        <div class="flex items-center gap-[12px]" data-node-m={m(n.trustRow)}>
          <span class="tm-label min-w-[101px]" data-node-m={m(n.trust1)}>{trust[0]}</span>
          <span aria-hidden="true" class="block w-px h-[14px] bg-white opacity-50"></span>
          <span class="tm-label min-w-[155px]" data-node-m={m(n.trust3)}>{trust[2]}</span>
        </div>
        <span class="tm-label" data-node-m={m(n.trust2)}>{trust[1]}</span>
      </div>
      <div class="w-full lg:w-auto flex flex-col gap-[12px] lg:flex-row lg:gap-[16px]" {...dn(n.ctas)}>
        <Button href={ROUTES.freeClaimReview} variant="on-dark" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]" {...dn(n.cta1)}>Schedule a Free Review</Button>
        <Button href={PHONE_TEL} variant="outline-on-dark" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[235px]" {...dn(n.cta2)}>Call {PHONE_DISPLAY}</Button>
      </div>
      <ul class="hidden lg:flex m-0 p-0 pt-[8px] list-none items-center gap-[20px] text-white" data-node={d(n.trust)}>
        <li class="bs-chero__trust min-w-[120px]" data-node={d(n.trust1)}>{trust[0]}</li>
        <li aria-hidden="true" class="w-px h-[16px] bg-white opacity-50"></li>
        <li class="bs-chero__trust min-w-[333px]" data-node={d(n.trust2)}>{trust[1]}</li>
        <li aria-hidden="true" class="w-px h-[16px] bg-white opacity-50"></li>
        <li class="bs-chero__trust min-w-[184px]" data-node={d(n.trust3)}>{trust[2]}</li>
      </ul>
    </div>
    {caption && (
      <div class="hidden lg:flex absolute right-[80px] top-[708px] items-center gap-[12px] opacity-85" data-node={d(n.caption)}>
        <span aria-hidden="true" class="block w-[32px] h-px bg-white"></span>
        <span class="t-caption text-white">Field photograph</span>
      </div>
    )}
  </div>
  <div aria-hidden="true" class="bs-chero__ruler absolute left-0 right-0 bottom-0 h-[16px] hidden lg:block opacity-35" data-node={d(n.ruler)}></div>
</section>

<style is:global>
  .bs-chero__trust { font-family: var(--font-body); font-weight: 500; font-size: 15px; line-height: 24px; white-space: nowrap; }
  .bs-chero__ramp { background: linear-gradient(to bottom, rgb(7 15 51 / 0) 0%, rgb(7 15 51 / .19) 25%, rgb(7 15 51 / .44) 50%, rgb(7 15 51 / .71) 75%, rgb(7 15 51 / 1) 100%); }
  .bs-chero__ruler {
    background:
      linear-gradient(to right, #fff 1px, transparent 1px) left top / 80px 16px repeat-x,
      linear-gradient(to right, #fff 1px, transparent 1px) left top / 40px 10px repeat-x,
      linear-gradient(to right, #fff 1px, transparent 1px) left top / 8px 6px repeat-x;
  }
</style>
