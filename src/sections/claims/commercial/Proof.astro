---
// Commercial / Xactimate and IH (kit Prose layout): rail (§ chip + H2 + ticks), two paragraphs, the smoke result with its
// disclaimer, the fire and smoke link, and the two page buttons. Page-specific because the kit Prose has no result or buttons.
import Button from '../../../components/Button.astro';
import KitStyles from '../../kit/KitStyles.astro';
import { md } from '../../kit/md';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../../data/site';
import Chip from '../Chip.astro';
import Ticks from '../Ticks.astro';

interface Props { chip: string; id: string; title: string; body: string[]; result: { title: string; text: string }; disclaimer: string; link: string }
const { chip, id, title, body, result, disclaimer, link } = Astro.props;
---
<KitStyles />
<section aria-labelledby={id} class="bg-paper">
  <div class="max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[56px] lg:px-[80px] lg:py-[120px] flex flex-col gap-[32px] lg:flex-row lg:items-start lg:gap-[112px]">
    <div class="flex flex-col items-start gap-[16px] lg:gap-[24px] lg:w-[360px] lg:shrink-0">
      <Chip>{chip}</Chip>
      <h2 id={id} class="m-0 w-full text-navy tm-h2 lg:t-h2">{title}</h2>
      <Ticks class="w-[200px] lg:w-[360px] opacity-50 lg:opacity-40 text-navy" />
    </div>
    <div class="bs-kit-prose lg:flex-1 lg:min-w-0">
      {body.map((p) => <p class="m-0 text-ink tm-body lg:t-lead" set:html={md(p)} />)}
      <figure class="m-0 mt-[32px] lg:mt-[40px] bg-white border-l-[3px] border-royal px-[20px] py-[24px] lg:px-[32px] lg:py-[32px]">
        <p class="m-0 text-navy tm-h3 lg:t-h3">{result.title}</p>
        <p class="m-0 mt-[8px] lg:mt-[12px] text-ink tm-body lg:t-lead">{result.text}</p>
        <figcaption class="mt-[16px] t-caption text-muted"><em>{disclaimer}</em></figcaption>
      </figure>
      <p class="m-0 mt-[24px] text-ink tm-body-strong lg:t-body-strong" set:html={md(link)} />
      <div class="mt-[32px] w-full flex flex-col gap-[12px] lg:flex-row lg:gap-[16px]">
        <Button href={ROUTES.freeClaimReview} variant="solid" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]">Schedule a Free Review</Button>
        <Button href={PHONE_TEL} variant="outline" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[235px]">Call {PHONE_DISPLAY}</Button>
      </div>
    </div>
  </div>
</section>
