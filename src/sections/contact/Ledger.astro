---
// § 02 Call + contact ledger (paper + blueprint grid): desktop 128:4291 (1280×736), mobile 128:6623 (390×814).
import Icon from '../../components/Icon.astro';
import SectionIndex from './SectionIndex.astro';
import { PHONE_DISPLAY, PHONE_TEL, LICENSE } from '../../data/site';
const EMAIL = 'mike@bluestaradjusters.com';
const MAP = 'https://www.google.com/maps/search/?api=1&query=1610+R+Street+Suite+300+Sacramento+CA+95811';
const rows = [
  { icon: 'phone', label: 'Call', value: PHONE_DISPLAY, href: PHONE_TEL,
    d: { row: '128:4303', label: '128:4308', value: '128:4310' }, m: { row: '128:6635', label: '128:6640', value: '128:6641' } },
  { icon: 'mail', label: 'Email', value: EMAIL, href: `mailto:${EMAIL}`,
    d: { row: '128:4311', label: '128:4317', value: '128:4319' }, m: { row: '128:6644', label: '128:6650', value: '128:6651' } },
  { icon: 'map-pin', label: 'Head office', value: '1610 R Street, Suite 300, Sacramento, California 95811', href: MAP, external: true,
    d: { row: '128:4320', label: '128:4326', value: '128:4328' }, m: { row: '128:6654', label: '128:6660', value: '128:6661' } },
  { icon: 'clock', label: 'Hours', value: 'Monday to Friday, 9 AM to 5 PM Pacific. Closed Saturday and Sunday.',
    d: { row: '128:4329', label: '128:4335', value: '128:4337' }, m: { row: '128:6664', label: '128:6670', value: '128:6671' } },
  { icon: 'shield', label: 'Licence', value: LICENSE,
    d: { row: '128:4338', label: '128:4344', value: '128:4346' }, m: { row: '128:6672', label: '128:6678', value: '128:6679' } },
];
const mail = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5.25" width="18" height="13.5" rx="1.5"/><path d="m3.75 6.75 8.25 6 8.25-6"/></svg>';
---
<section aria-labelledby="ct-call-label" class="ct-ledger relative overflow-hidden bg-paper" data-node="128:4291" data-node-m="128:6623">
  <div aria-hidden="true" class="ct-grid absolute left-0 top-0 w-full" data-node="128:4347" data-node-m="128:6680"></div>
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[56px] lg:px-[80px] lg:pt-[112px] lg:pb-[112px]">
  <div class="lg:flex lg:justify-between lg:items-start" data-node="128:4292">
    <div class="lg:w-[600px] lg:min-w-0 lg:mt-[151px]" data-node="128:4293">
      <SectionIndex n="§ 02" node="128:6032" nodeM="128:6624" />
      <a href={PHONE_TEL} class="ct-bigcall block mt-[40px] pt-[4px] pb-[4px] lg:pt-0 lg:pb-0 lg:mt-[48px] w-full lg:w-fit" aria-label={`Call ${PHONE_DISPLAY}`} data-node-m="128:6627">
        <span class="flex items-center gap-[8px] lg:gap-[12px] w-fit text-navy" data-node="128:4294" data-node-m="128:6628">
          <Icon name="phone" size={20} />
          <span class="tm-label lg:t-label text-ink">Call</span>
        </span>
        <span class="ct-bigcall__num block mt-[12px] lg:mt-[20px] text-navy whitespace-nowrap" data-node="128:4299" data-node-m="128:6632">{PHONE_DISPLAY}</span>
        <span aria-hidden="true" class="ct-bigcall__line block mt-[12px] h-[4px] bg-royal" data-node="128:4301" data-node-m="128:6633"></span>
      </a>
    </div>

    <ul class="ct-rows m-0 p-0 list-none mt-[40px] lg:mt-0 lg:w-[456px] border-t border-navy" data-node="128:4302" data-node-m="128:6634">
      {rows.map((r) => {
        const Tag = r.href ? 'a' : 'div';
        return (
          <li><Tag href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}
            class:list={['ct-row flex items-start gap-[16px] lg:gap-[20px] border-b border-line', r.href && 'ct-row--link']} data-node={r.d.row} data-node-m={r.m.row}>
            <span aria-hidden="true" class="ct-row__icon flex items-center justify-center shrink-0 w-[40px] h-[40px] rounded-full border border-navy bg-white text-navy">
              {r.icon === 'mail' ? <Fragment set:html={mail} /> : <Icon name={r.icon} size={20} />}
            </span>
            <div class="flex-1 min-w-0 flex flex-col gap-[4px] pt-[4px] lg:pt-0">
              <span class="block tm-label lg:t-label text-ink w-fit lg:w-auto" data-node={r.d.label} data-node-m={r.m.label}>{r.label}</span>
              <span class="block ct-row__value text-ink" data-node={r.d.value} data-node-m={r.m.value}>{r.value}</span>
            </div>
            {r.href && <span aria-hidden="true" class="ct-row__arrow lg:hidden shrink-0 text-navy"><Icon name="arrow-right" size={20} /></span>}
          </Tag></li>
        );
      })}
    </ul>
  </div>
  </div>
</section>

<style>
  .ct-grid {
    height: 814px; padding-bottom: 12px; box-sizing: border-box; background-clip: content-box; background-origin: content-box;
    background:
      linear-gradient(to right, #dce0eb 1px, transparent 1px) 0 0 / 200px 100%,
      linear-gradient(to bottom, #dce0eb 1px, transparent 1px) 0 0 / 100% 200px,
      linear-gradient(to right, #e8eaf3 1px, transparent 1px) 0 0 / 40px 100%,
      linear-gradient(to bottom, #e8eaf3 1px, transparent 1px) 0 0 / 100% 40px;
  }
  @media (min-width: 64rem) { .ct-grid { height: 736px; padding-bottom: 16px; } }
  .ct-bigcall__num { font-family: var(--font-display); font-weight: 700; font-size: 48px; line-height: 48px; letter-spacing: -0.03em; width: 316px; white-space: nowrap; }
  .ct-bigcall__line { width: 316px; }
  @media (min-width: 64rem) { .ct-bigcall__num { font-size: 88px; line-height: 88px; letter-spacing: -2.64px; width: 579px; } .ct-bigcall__line { width: 579px; } }
  .ct-bigcall:hover .ct-bigcall__num, .ct-bigcall:focus-visible .ct-bigcall__num { color: var(--color-royal); }
  @media (min-width: 64rem) and (max-width: 79.999rem) {
    [data-node="128:4292"] { gap: 48px; }
    [data-node="128:4293"] { width: auto; flex: 1 1 0; }
    .ct-rows { width: 400px; flex-shrink: 0; }
    .ct-bigcall__num { font-size: 60px; line-height: 64px; letter-spacing: -1.8px; width: fit-content; }
    .ct-bigcall__line { width: 100%; }
  }
  .ct-row { padding: 16px 0; }
  .ct-row__value { font-family: var(--font-body); font-weight: 600; font-size: 16px; line-height: 26px; }
  .ct-row__arrow { width: 20px; }
  @media (max-width: 1023.98px) { .ct-row__value { position: relative; top: 1px; } }
  .ct-row--link:hover .ct-row__value, .ct-row--link:focus-visible .ct-row__value { color: var(--color-royal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  @media (min-width: 64rem) {
    .ct-row { padding: 20px 0; align-items: center; }
    .ct-row__value { font-size: 17px; line-height: 28px; }
  }
</style>
