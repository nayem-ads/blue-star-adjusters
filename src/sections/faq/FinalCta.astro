---
// FAQ Final CTA. Desktop 217:7619 (1280×569), mobile 217:11315 (390×667). Navy band: royal rule + H2 (left),
// lead, on-dark buttons and hours (right), faint white B-mark (5 %), white ruler ticks along the bottom edge.
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import Ruler from './Ruler.astro';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../data/site';
---
<section aria-labelledby="faq-cta" class="relative overflow-hidden bg-navy text-white" data-node="217:7619" data-node-m="217:11315">
  <span aria-hidden="true" class="absolute pointer-events-none opacity-[.05] left-[27.6px] top-[367px] lg:left-auto lg:right-0 lg:top-0" data-node="217:7639" data-node-m="217:11316">
    <Logo variant="mark-white" bare width={468.652} height={569} label="" class="hidden lg:block" />
    <Logo variant="mark-white" bare width={362.4} height={440} label="" class="lg:hidden" />
  </span>
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[72px] lg:px-[80px] lg:py-[120px] lg:flex lg:items-end lg:gap-[112px]">
    <div class="flex flex-col items-start gap-[24px] lg:gap-[32px] lg:w-[648px] lg:shrink-0" data-node="217:7620" data-node-m="217:11321">
      <span aria-hidden="true" class="block w-[48px] h-[2px] bg-royal" data-node="217:7621" data-node-m="217:11322"></span>
      <h2 id="faq-cta" class="m-0 tm-display lg:t-display-l text-white w-full" data-node="217:7622" data-node-m="217:11323">Call Before the Carrier Sets the Narrative.</h2>
    </div>
    <div class="mt-[40px] lg:mt-0 flex flex-col items-start gap-[32px] lg:w-[360px] lg:shrink-0" data-node="217:7623" data-node-m="217:11324">
      <p class="m-0 tm-lead lg:t-lead text-white w-full" data-node="217:7624" data-node-m="217:11325">Your insurance company has an adjuster protecting their interests. You have the right to one too.</p>
      <div class="w-full flex flex-col items-start gap-[12px] lg:w-auto lg:gap-[16px]" data-node="217:7625" data-node-m="217:11326">
        <Button href={ROUTES.freeClaimReview} variant="on-dark" class="h-[56px] w-full lg:h-[52px] lg:w-auto" node="217:7626" data-node-m="217:11327">Schedule a Free Review</Button>
        <Button href={PHONE_TEL} variant="outline-on-dark" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto" node="217:7630" data-node-m="217:11328">Call {PHONE_DISPLAY}</Button>
      </div>
      <p class="m-0 w-full flex items-center gap-[12px] pt-[24px] border-t border-white" data-node="217:7634" data-node-m="217:11329">
        <span class="block shrink-0 w-[24px] h-[24px]" data-node="217:7635" data-node-m="217:11330"><Icon name="clock" size={24} class="block" /></span>
        <span class="flex-1 min-w-0 text-[15px] leading-[24px] font-medium" data-node="217:7638" data-node-m="217:11331">Monday to Friday, 9 AM to 5 PM Pacific.</span>
      </p>
    </div>
  </div>
  <Ruler anchor="bottom" class="absolute left-0 bottom-0 w-full h-[16px] text-white opacity-25" node="217:7644" nodeM="217:11339" />
</section>
