---
// Icon circle (40px, or 44 / 56): white fill + 1px navy stroke by default. tone: 'outline' | 'paper' | 'navy' | 'ghost' (white stroke on navy) | 'solid-white'.
import Icon from '../../components/Icon.astro';
interface Props { name: string; size?: number; icon?: number; tone?: 'outline'|'paper'|'navy'|'ghost'|'solid-white'; class?: string; node?: string; nodeM?: string }
const { name, size = 40, icon = 24, tone = 'outline', class: cls = '', node, nodeM } = Astro.props;
const tones = {
  outline: 'bg-white border border-navy text-navy',
  paper: 'bg-paper text-navy',
  navy: 'bg-navy text-white',
  ghost: 'border border-white text-white',
  'solid-white': 'bg-white border border-white text-navy',
};
---
<span aria-hidden="true" class:list={['flex items-center justify-center rounded-full shrink-0 box-border', tones[tone], cls]} style={`width:${size}px;height:${size}px`} data-node={node} data-node-m={nodeM}>
  <Icon name={name} size={icon} />
</span>
