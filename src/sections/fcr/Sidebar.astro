---
// Desktop sidebar (73:1611 / 74:1926 / 74:2188): What happens next (navy), How fees work, contact details,
// (Where we work 85:3246 now sits under the form card on desktop, see RequestSection). Hidden below lg: mobile gets NextSection + FeesSection instead.
import Steps from './Steps.astro';
import FeesPanel from './FeesPanel.astro';
import ContactList from './ContactList.astro';
import Watermark from './Watermark.astro';
interface Props { ty?: boolean }
const { ty = false } = Astro.props;
---
<aside class="hidden lg:flex flex-col gap-[24px] w-[376px] shrink-0" aria-label="What happens next, fees and contact" data-node={ty ? '74:2188' : '73:1611'}>
  <div class="relative overflow-hidden bg-navy rounded-[4px] px-[32px] py-[40px] flex flex-col gap-[32px]" data-node={ty ? '74:2189' : '73:2697'}>
    <Watermark width={302.4} height={367.15} class="left-[176px] top-[120px]" />
    <h2 class="relative m-0 t-h3 text-white" data-node={ty ? '74:2191' : '73:2703'}>What Happens After You Submit</h2>
    <div class="relative" data-node={ty ? '74:2192' : '73:2704'}>
      <Steps variant="d" ty={ty} nodes={ty ? ['74:2193', '74:2203', '74:2213'] : ['73:2705', '73:2716', '73:2728']} />
    </div>
    <p class="relative m-0 font-body font-medium text-[15px] leading-[24px] text-white">If you hire us, the percentage is set in writing before we start. A senior adjuster leads your claim, from the first call to the final settlement.</p>
  </div>
  <FeesPanel variant="d" node={ty ? '74:2220' : '73:2737'} />
  <ContactList variant="d" node={ty ? '74:2227' : '73:2746'} />
</aside>
