---
// 04 Public adjuster fees in California: what the law says. Desktop 128:4254; mobile 128:6303.
// Heading column (icon circle, index, H2, intro) + a seven-row ledger with citation chips, then license check.
import Icon from '../../components/Icon.astro';
import SectionIndex from './SectionIndex.astro';
import Chip from './Chip.astro';
import { md } from '../kit/md';
import KitStyles from '../kit/KitStyles.astro';
const rows = [
  { chip: '15027(a)', text: "No signed contract, no work. A public adjuster can't act on your claim until you sign a written contract on a form the Insurance Commissioner has approved." },
  { chip: '15027(b)(12) and (f)(3)', text: 'The contract states the percentage and the amount it applies to. You initial the fee line.' },
  { chip: '15027(b)(7)', d: '128:4266', m: '128:6317', text: 'In California, our fee can never leave you with less than your insurer had already paid before you hired us.' },
  { chip: '15027(c)(1)', text: "The fee is taken as a percentage of each insurance payment. It can't all come out of the first check, and it can't be collected on money the insurer owes but hasn't paid yet." },
  { chip: '15027.5', text: "A public adjuster can't collect fees beyond what the contract provides. Any compensation from someone connected to the claim, such as a contractor, an insurer or a vendor, has to be disclosed to you." },
  { chip: '15027(b)(13) and (y)', d: '128:4272', m: '128:6322', text: 'You can cancel within three business days of signing and receiving the contract. Five calendar days in a declared catastrophic disaster area.' },
  { chip: null, d: '128:4278', m: '128:6327', text: 'You have final say on every settlement.' },
];
---
<KitStyles />
<section aria-labelledby="fees-protect" class="bg-white" data-node="128:4254" data-node-m="128:6303">
  <div class="max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[56px] lg:pl-[80px] lg:pr-[72px] lg:pt-[120px] lg:pb-[120px] flex flex-col lg:flex-row lg:justify-between lg:items-start lg:gap-[40px]">
    <div class="flex flex-col items-start lg:w-[360px] lg:shrink-0" data-node="128:4255">
      <span aria-hidden="true" class="flex items-center justify-center rounded-full border-[1.5px] border-navy text-navy w-[40px] h-[40px] lg:w-[56px] lg:h-[56px]" data-node="128:4256" data-node-m="128:6304"><Icon name="shield" size={24} /></span>
      <SectionIndex label="04" class="mt-[24px] lg:mt-[32px]" node="128:4260" nodeM="128:6309" textNode="128:4261" textNodeM="128:6310" />
      <h2 id="fees-protect" class="m-0 mt-[12px] lg:mt-[32px] text-navy tm-h2 lg:t-h2 w-full" data-node="128:4263" data-node-m="128:6313">Public Adjuster Fees in California: What the Law Says</h2>
      <p class="m-0 mt-[16px] lg:mt-[24px] text-ink tm-body lg:t-body">These rules sit in the California Insurance Code. They bind every licensed public adjuster in the state, Blue Star included.</p>
    </div>
    <div class="mt-[32px] lg:mt-0 w-full lg:flex-[0_1_744px] lg:min-w-0">
      <ul class="m-0 p-0 list-none w-full border-t border-navy" data-node="128:4264" data-node-m="128:6315">
        {rows.map((r) => (
          <li class="flex flex-col gap-[12px] pt-[24px] pb-[24px] border-b border-line lg:flex-row lg:items-start lg:gap-[24px] lg:pt-[32px] lg:pb-[32px]" data-node={r.d} data-node-m={r.m}>
            <div class="lg:w-[200px] lg:shrink-0 lg:pt-[4px]">
              {r.chip
                ? <Chip>{r.chip}</Chip>
                : <span class="flex items-center gap-[8px] text-royal"><Icon name="check" size={24} /><span class="tm-label lg:t-label whitespace-nowrap">Final say</span></span>}
            </div>
            <p class="m-0 text-ink tm-lead lg:t-lead lg:flex-1 lg:min-w-0">{r.text}</p>
          </li>
        ))}
      </ul>
      <div class="flex flex-col gap-[12px] mt-[32px] lg:mt-[40px]">
        <p class="m-0 text-ink tm-body lg:t-body">These are California's rules. Other states set their own.</p>
        <p class="m-0 text-ink tm-body lg:t-body">Check any public adjuster's license before you sign. Ours is CA DOI License No. 6015234.</p>
        <p class="m-0 text-ink tm-body lg:t-body-strong" set:html={md('[Check a license with the California Department of Insurance](https://cdicloud.insurance.ca.gov/cal/LicenseNumberSearch)')} />
      </div>
    </div>
  </div>
</section>
