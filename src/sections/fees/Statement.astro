---
// § 01 Fee statement. Desktop 128:3492 (y 792, 1280×608); mobile 128:6219 (y 946, 390×376).
// Paper + full-bleed 40px blueprint grid (navy 5%, major every 160 at 10%). Locked fee line, word for word.
import SectionIndex from './SectionIndex.astro';
import DimLine from './DimLine.astro';
---
<section aria-labelledby="fees-statement" class="relative bg-paper overflow-hidden" data-node="128:3492" data-node-m="128:6219">
  <div aria-hidden="true" class="bs-fees-grid absolute inset-0" data-node="128:3505" data-node-m="128:6232"></div>
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[64px] lg:px-[80px] lg:pt-[112px] lg:pb-[116px]">
    <SectionIndex label="§ 01" node="128:3493" nodeM="128:6220" textNode="128:3494" textNodeM="128:6221" />
    <div class="flex flex-col gap-[16px] mt-[24px] lg:gap-[36px] lg:mt-[40px] w-full lg:w-[1061px] lg:max-w-full" data-node="128:3554" data-node-m="128:6224">
      <h2 id="fees-statement" class="bs-fees-statement m-0 text-navy" data-node="128:3497" data-node-m="128:6225">No upfront cost.<br class="hidden lg:inline" /> We're paid a percentage<br class="hidden lg:inline" /> of what we recover.</h2>
      <DimLine label="Set in writing before we start" node="128:3499" nodeM="128:6226" />
    </div>
  </div>
</section>
<style>
  .bs-fees-grid {
    --g: rgb(8 29 94 / .05);
    background-image:
      linear-gradient(to right, var(--g) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g) 1px, transparent 1px),
      linear-gradient(to right, var(--g) 1px, transparent 1px),
      linear-gradient(to bottom, var(--g) 1px, transparent 1px);
    background-size: 40px 100%, 100% 40px, 160px 100%, 100% 160px;
    background-position: 20px 0, 0 24px, 20px 0, 0 24px; /* mobile grid: lines at x 20+40n, y 24+40n; majors every 160 */
  }
  .bs-fees-statement { font-family: var(--font-display); font-weight: 700; font-size: 44px; line-height: 44px; letter-spacing: -0.03em; }
  @media (min-width: 1024px) {
    .bs-fees-grid { background-position: 0 0, 0 0, 80px 0, 0 0; }
    /* 96/90 at 1280; scales down between 1024 and 1280 so the three locked lines always fit the 1061 measure. */
    .bs-fees-statement { --s: min(1, calc((100vw - 160px) / 1061px)); font-size: calc(96px * var(--s)); line-height: calc(90px * var(--s)); letter-spacing: -0.03em; white-space: nowrap; }
  }
</style>
