---
// S3 Results (navy). Desktop 73:2348; mobile M3 74:3178. The old builder copy and four facts are replaced by three Blue Star results
// in the same ruled grid (three columns on desktop, a ruled list on mobile), with the locked results disclaimer.
import Button from '../../components/Button.astro';
import Logo from '../../components/Logo.astro';
import Badge from './Badge.astro';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../data/site';
const results = [
  { icon: 'flame', title: 'Los Angeles house fire, full strip out.', body: 'Offered $38,000. Settled at $276,000.' },
  { icon: 'search', title: 'Smoke damage.', body: 'Offered $17,000. Settled for about $1.1 million. An industrial hygienist proved combustion byproducts in the porous materials and doors.' },
  { icon: 'home', title: '800 square foot apartment fire, started by a computer.', body: 'Settled for nearly $200,000, including the tongue and groove ceiling and smoke mitigation for the neighboring unit.' },
];
---
<section aria-labelledby="background-title" class="relative overflow-hidden bg-navy text-white" data-node="73:2348" data-node-m="74:3178">
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[71px] lg:px-[80px] lg:pt-[120px] lg:pb-[120px]">
    <div aria-hidden="true" class="absolute right-0 top-[991.85px] w-[302.4px] h-[367.15px] lg:top-[379.15px] lg:w-[561.6px] lg:h-[681.85px] opacity-[.07] pointer-events-none" data-node="73:2349" data-node-m="74:3179">
      <Logo variant="mark-white" bare width={216} height={263} class="w-[302.4px] h-[368.2px] lg:w-[561.6px] lg:h-[683.8px]" label="" />
    </div>

    <div class="relative flex flex-col gap-[32px] lg:flex-row lg:items-start lg:gap-[64px]" data-node="73:2354">
      <div class="flex flex-col gap-[32px] lg:gap-[24px] lg:flex-[0_1_720px] lg:min-w-0" data-node="73:2355">
        <p class="bs-ftagline m-0 flex items-center gap-[12px] self-start whitespace-nowrap tm-label" data-node="73:2356" data-node-m="74:3184">
          <span aria-hidden="true" class="block w-[32px] h-px bg-white"></span>Your Claim. Our Fight.<span aria-hidden="true" class="block w-[32px] h-px bg-white"></span>
        </p>
        <h2 id="background-title" class="m-0 tm-h2 lg:t-h2" data-node="73:2360" data-node-m="74:3188">What the Carrier Offered. What We Recovered.</h2>
      </div>
    </div>

    <ul class="relative m-0 p-0 list-none mt-[32px] flex flex-col lg:mt-[72px] lg:grid lg:grid-cols-3 lg:items-start lg:gap-x-[32px] lg:border-t lg:border-white" aria-label="Claim results" data-node="73:2363" data-node-m="74:3190">
      {results.map((r) => (
        <li class="flex flex-col border-t border-white py-[20px] last:border-b lg:border-0 lg:last:border-b-0 lg:pt-[32px] lg:pb-0 lg:min-w-0">
          <div class="flex items-start gap-[16px] lg:flex-col lg:gap-[20px]">
            <Badge icon={r.icon} variant="on-dark" />
            <div class="flex-1 min-w-0 flex flex-col gap-[8px] lg:gap-[12px]">
              <p class="m-0 tm-body-strong lg:t-lead lg:font-semibold">{r.title}</p>
              <p class="m-0 tm-body lg:t-body text-white/90">{r.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="relative m-0 mt-[24px] lg:mt-[48px] t-caption text-white/80"><em>Results reflect specific losses and policies. Past results don't guarantee a similar outcome.</em></p>
    <p class="relative m-0 mt-[16px] tm-body lg:t-body"><a href="/results/" class="bs-fresults font-semibold">More claim results</a></p>

    <div class="relative flex flex-col gap-[12px] pt-[8px] mt-[32px] lg:w-fit lg:flex-row lg:flex-wrap lg:gap-[16px] lg:pt-0 lg:mt-[48px]" data-node="73:2387" data-node-m="74:3214">
      <Button href={ROUTES.freeClaimReview} variant="on-dark" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]" data-node="73:2388" data-node-m="74:3215">Schedule a Free Review</Button>
      <Button href={PHONE_TEL} variant="outline-on-dark" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[235px]" data-node="73:2393" data-node-m="74:3219">Call {PHONE_DISPLAY}</Button>
    </div>
  </div>
</section>
<style>
  .bs-fresults { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bs-fresults:hover, .bs-fresults:focus-visible { text-decoration-thickness: 2px; }
  .bs-fresults:focus-visible { outline-color: #fff; }
  @media (min-width: 1024px) { .bs-ftagline { font-weight: 500; font-size: 15px; line-height: 24px; letter-spacing: 0; } }
</style>
