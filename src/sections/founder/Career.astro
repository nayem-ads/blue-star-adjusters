---
// S2 Career line — Built From the Ground Up. Desktop 73:1917 (y 1096, 1280×848); mobile M2 74:2758 (y 1176, 390×1104).
// Desktop: horizontal track (one navy connector + end tick behind three badges), stages in three 352px columns.
// Mobile: vertical rail per stage (badge + connector), content to the right.
import Badge from './Badge.astro';
import DimLine from './DimLine.astro';
import Ruler from './Ruler.astro';
import { LICENSE } from '../../data/site';

const stages = [
  { icon: 'building', variant: 'outline', label: '25 years', title: 'Developer and merchant builder',
    body: 'Affordable housing, commercial projects and hospitality assets, measured and estimated to current building and fire code.',
    tag: 'Principal, MSR Properties',
    n: { badge: '73:2067', content: '73:2079', label: '73:2080', title: '73:2081', body: '73:2082', tag: '73:2083' },
    m: { stage: '74:2808', badge: '74:2810', line: '74:2813', content: '74:2814', label: '74:2815', title: '74:2816', body: '74:2817', tag: '74:2818' } },
  { icon: 'document', variant: 'outline', label: 'Then', title: 'Public adjuster',
    body: "Top producer at one of the nation's leading public adjusting firms, across hundreds of losses.",
    n: { badge: '73:2070', content: '73:2085', label: '73:2086', title: '73:2087', body: '73:2088' },
    m: { stage: '74:2820', badge: '74:2822', line: '74:2826', content: '74:2827', label: '74:2828', title: '74:2829', body: '74:2830' } },
  { icon: 'shield', variant: 'solid', label: 'Now', title: 'Founding Principal, Blue Star Adjusters',
    body: 'A boutique firm. Licensed personally in 7 states, always working for the insured, never for the carrier.',
    tag: LICENSE, last: true,
    n: { badge: '73:2074', content: '73:2089', label: '73:2090', title: '73:2091', body: '73:2092', tag: '73:2093' },
    m: { stage: '74:2831', badge: '74:2833', content: '74:2837', label: '74:2838', title: '74:2839', body: '74:2840', tag: '74:2841' } },
] as const;
---
<section aria-labelledby="career-title" class="bg-white" data-node="73:1917" data-node-m="74:2758">
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[62px] lg:px-[80px] lg:pt-[120px] lg:pb-[102px]">
    <Ruler class="absolute left-[20px] right-[20px] top-0 lg:left-[80px] lg:right-[80px]" node="73:1918" nodeM="74:2759" />

    <div class="flex flex-col gap-[16px] lg:flex-row lg:items-end lg:gap-[64px]" data-node="73:2060" data-node-m="74:2804">
      <div class="flex flex-col gap-[16px] lg:gap-[24px] lg:flex-[0_1_656px] lg:min-w-0" data-node="85:3263">
        <h2 id="career-title" class="m-0 text-navy tm-h2 lg:t-h2" data-node="73:2061" data-node-m="74:2805">Built From the Ground Up.</h2>
        <p class="m-0 text-ink tm-body lg:t-lead" data-node="73:2062" data-node-m="74:2806">Michael Rapport spent 25 years as a developer and merchant builder before he became a public adjuster. He has built to San Francisco's seismic retrofit ordinance, and he knows what a code-compliant rebuild costs because he's paid for plenty of them.</p>
      </div>
      <div class="hidden lg:flex flex-col gap-[24px] w-[400px] shrink-0" data-node="85:3264">
        <DimLine label="Measured, not estimated" tone="royal" class="w-full" node="85:3265" />
        <p class="m-0 flex items-center gap-[16px] pl-[16px] pr-[20px] py-[16px] bg-paper border border-line" data-node="85:3271">
          <Badge icon="ruler" variant="paper" stroked node="85:3272" />
          <span class="flex-1 min-w-0 t-body-strong text-ink" data-node="85:3274">25 years as a developer and builder</span>
        </p>
      </div>
    </div>

    <div class="relative mt-[40px] lg:mt-[80px]" data-node="73:2063" data-node-m="74:2807">
      <span aria-hidden="true" class="hidden lg:block absolute left-[20px] right-0 top-[19px] h-[2px] bg-navy" data-node="73:2065"></span>
      <span aria-hidden="true" class="hidden lg:block absolute right-0 top-[12px] w-px h-[16px] bg-navy" data-node="73:2066"></span>
    <ol class="relative m-0 p-0 list-none flex flex-col lg:flex-row lg:items-start lg:gap-[32px]">
      {stages.map((s) => (
        <li class="flex gap-[16px] lg:flex-col lg:gap-[32px] lg:flex-1 lg:basis-0 lg:min-w-0" data-node-m={s.m.stage}>
          <div class="flex flex-col items-center self-stretch shrink-0 lg:self-start">
            <Badge icon={s.icon} variant={s.variant} node={s.n.badge} nodeM={s.m.badge} />
            {!('last' in s) && <span aria-hidden="true" class="block w-[2px] flex-1 bg-navy lg:hidden" data-node-m={s.m.line}></span>}
          </div>
          <div class:list={['flex-1 min-w-0 flex flex-col items-start gap-[8px] pt-[8px] lg:gap-[12px] lg:pt-0 lg:pb-0', !('last' in s) && 'pb-[40px]']} data-node={s.n.content} data-node-m={s.m.content}>
            <p class="m-0 w-full text-royal tm-label lg:t-label" data-node={s.n.label} data-node-m={s.m.label}>{s.label}</p>
            <h3 class="m-0 w-full text-navy tm-h3 lg:t-h3" data-node={s.n.title} data-node-m={s.m.title}>{s.title}</h3>
            <p class="m-0 w-full text-ink tm-body lg:t-body" data-node={s.n.body} data-node-m={s.m.body}>{s.body}</p>
            {'tag' in s && <p class="bs-ftag m-0 border border-line rounded-[2px] px-[8px] py-[4px] whitespace-nowrap text-ink tm-label" data-node={s.n.tag} data-node-m={s.m.tag}>{s.tag}</p>}
          </div>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>
<style>
  @media (min-width: 1024px) { .bs-ftag { font-weight: 500; font-size: 15px; line-height: 24px; letter-spacing: 0; } }
</style>
