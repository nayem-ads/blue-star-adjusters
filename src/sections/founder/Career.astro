---
// S2 The Record. Desktop 73:1917; mobile M2 74:2758. The old 25 years / Then / Now timeline is replaced by a credentials list:
// desktop three columns × two rows of badge + text cells with ruled tops, mobile one ruled column.
import Badge from './Badge.astro';
import Ruler from './Ruler.astro';
import { md } from '../kit/md';

const items = [
  { icon: 'shield', text: '**Michael Rapport, public adjuster.** Founding Principal, Blue Star Adjusters. Head office at 1610 R Street, Suite 300, Sacramento, California 95811.' },
  { icon: 'search', text: "**Top producer** at one of the nation's leading public adjusting firms, across hundreds of losses." },
  { icon: 'document', text: "**Michael Rapport's personal license.** CA DOI License No. 2B60428." },
  { icon: 'map-pin', text: '**Firm licenses, Blue Star Adjusters LLC.** California 6015234 · Nevada 4263596 · Oregon 3004448214 · Colorado 969283 · Washington 1382428 · Arizona 3004469742.' },
  { icon: 'building', text: '**PCAPIA member.** Blue Star Adjusters belongs to PCAPIA.' },
  { icon: 'check', text: '**We represent the insured only.** Never the carrier.' },
];
---
<section aria-labelledby="career-title" class="bg-white" data-node="73:1917" data-node-m="74:2758">
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[62px] lg:px-[80px] lg:pt-[120px] lg:pb-[112px]">
    <Ruler class="absolute left-[20px] right-[20px] top-0 lg:left-[80px] lg:right-[80px]" node="73:1918" nodeM="74:2759" />

    <h2 id="career-title" class="m-0 text-navy tm-h2 lg:t-h2 lg:max-w-[800px]" data-node="73:2061" data-node-m="74:2805">The Record. Michael Rapport, Public Adjuster.</h2>

    <ul class="m-0 mt-[32px] p-0 list-none flex flex-col border-b border-line lg:mt-[64px] lg:grid lg:grid-cols-3 lg:gap-x-[32px] lg:border-b-0">
      {items.map((it) => (
        <li class="flex items-start gap-[16px] py-[20px] border-t border-navy lg:flex-col lg:gap-[20px] lg:pt-[28px] lg:pb-[40px] lg:min-w-0">
          <Badge icon={it.icon} variant="outline" />
          <p class="m-0 flex-1 min-w-0 text-ink tm-body lg:t-body" set:html={md(it.text)} />
        </li>
      ))}
    </ul>

    <p class="m-0 mt-[24px] tm-body lg:t-body lg:mt-[8px]">
      <a href="https://cdicloud.insurance.ca.gov/cal/LicenseNumberSearch" rel="noopener" target="_blank" class="bs-fcdi text-royal font-semibold">Check a license with the California Department of Insurance</a>
    </p>
  </div>
</section>
<style>
  .bs-fcdi { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .bs-fcdi:hover, .bs-fcdi:focus-visible { text-decoration-thickness: 2px; }
</style>
