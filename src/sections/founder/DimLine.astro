---
// Detail / Dimension line (71:527) as used on the founder page: tick, rule, caption, rule, tick (royal).
// tone: label colour ('ink' for most instances on this page, 'royal' = component default). Width via class.
interface Props { label: string; tone?: 'ink' | 'royal'; class?: string; node?: string; nodeM?: string }
const { label, tone = 'ink', class: cls = '', node, nodeM } = Astro.props;
---
<div aria-hidden="true" class:list={['flex items-center gap-[8px] h-[16px]', cls]} data-node={node} data-node-m={nodeM}>
  <span class="block w-px h-[12px] bg-royal shrink-0"></span>
  <span class="block flex-1 min-w-px h-px bg-royal"></span>
  <span class:list={['t-caption whitespace-nowrap', tone === 'ink' ? 'text-ink' : 'text-royal']}>{label}</span>
  <span class="block flex-1 min-w-px h-px bg-royal"></span>
  <span class="block w-px h-[12px] bg-royal shrink-0"></span>
</div>
