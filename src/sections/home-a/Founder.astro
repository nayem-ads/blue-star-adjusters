---
// Founder: Senior Led. Start to Finish. (Figma Homepage v2 482:1652; builder bio, builder chips and quote removed). Desktop 54:192, mobile 62:693.
import Pic from './Pic.astro';
import Button from '../../components/Button.astro';
import CropMarks from './CropMarks.astro';
import FactChip from './FactChip.astro';
import { ROUTES } from '../../data/site';
---
<section aria-labelledby="founder-title" class="bg-paper overflow-hidden" data-node="54:192" data-node-m="62:693">
  <div class="max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[56px] lg:px-[80px] lg:py-[120px] flex flex-col gap-[24px] lg:flex-row lg:items-center lg:gap-[96px]">
    <div class="relative h-[420px] lg:h-[560px] lg:w-[448px] lg:shrink-0">
          <Pic d="54:193" m="62:694" alt="Portrait of Michael Rapport, founding principal of Blue Star Adjusters." />
      <CropMarks class="absolute -inset-[10px] lg:-inset-[12px]" node="73:2491" nodeM="74:3393" />
    </div>
    <div class="flex flex-col items-start gap-[24px] lg:gap-[28px] lg:flex-1 lg:min-w-0" data-node="54:194">
      <h2 id="founder-title" class="m-0 tm-h2 lg:t-h2 text-navy w-full" data-node="54:195" data-node-m="62:695">Senior Led.<br /> Start to Finish.</h2>
      <div class="flex flex-col gap-[16px] w-full">
        <p class="m-0 tm-body lg:t-body text-ink" data-node="54:196" data-node-m="62:696">Every Blue Star claim is led by a senior adjuster, from the first call to the final settlement. The person who reads your policy is the person who negotiates it. We built the firm that way on purpose, so you get the experience of a large firm without being handed off.</p>
        <p class="m-0 tm-body lg:t-body text-ink">Michael Rapport founded Blue Star Adjusters. Before that, he was a top producer at one of the nation’s leading public adjusting firms, across hundreds of losses.</p>
      </div>
      <ul class="m-0 p-0 list-none flex flex-wrap gap-[12px] w-full" data-node="73:2503">
        <li><FactChip icon="shield" node="73:2504" nodeM="74:3388">Senior adjuster on every claim</FactChip></li>
        <li><FactChip icon="check" node="73:2509">PCAPIA member</FactChip></li>
      </ul>
      <p class="m-0 tm-body text-ink lg:text-[15px] lg:leading-[24px] font-medium" data-node="54:199" data-node-m="62:699">Michael Rapport, Founding Principal</p>
      <Button href={ROUTES.founder} variant="outline" class="founder-btn h-auto min-h-[56px] py-[14px] px-[24px] w-full text-center lg:h-[52px] lg:min-h-0 lg:py-0 lg:w-auto" data-node="54:200" data-node-m="62:700">Meet Michael Rapport, licensed public adjuster</Button>
    </div>
  </div>
</section>


<style>
  :global(.founder-btn) { white-space: normal; }
</style>
