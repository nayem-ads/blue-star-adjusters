---
// Who we serve: A Boutique Practice. A Family Office. Desktop 57:278, mobile 63:694.
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import TaglineRule from './TaglineRule.astro';
---
<section aria-labelledby="serve-title" class="relative bg-navy text-white overflow-hidden" data-node="57:278" data-node-m="63:694">
  <span aria-hidden="true" class="lg:hidden absolute left-[200px] -top-[30px] opacity-[.06] pointer-events-none"><Logo variant="mark-white" bare width={312} height={380} label="" /></span>
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[64px] lg:px-[80px] lg:py-[120px] flex flex-col gap-[20px] lg:flex-row lg:items-start lg:gap-[96px]">
    <div class="contents lg:flex lg:flex-col lg:items-start lg:gap-[40px] lg:flex-1 lg:min-w-0 lg:max-w-[640px]" data-node="85:3089">
      <h2 id="serve-title" class="order-2 lg:order-none m-0 tm-h2 lg:t-display-l lg:w-full" data-node="57:279" data-node-m="63:695">A Boutique Practice.<br /> A Family Office.</h2>
      <TaglineRule class="hidden lg:flex" node="85:3090" />
    </div>
        <div class="contents lg:relative lg:flex lg:flex-col lg:items-start lg:gap-[24px] lg:w-[384px] lg:shrink-0 lg:h-[333px]" data-node="74:1683">
      <div aria-hidden="true" class="hidden lg:block absolute -left-[48px] top-0 w-px h-[333px] bg-white" data-node="74:1688"></div>
      <span class="order-1 lg:order-none flex items-center justify-center w-[48px] h-[48px] rounded-full border border-white shrink-0" data-node="74:1684" data-node-m="74:3641"><Icon name="shield" size={24} /></span>
      <p class="order-3 lg:order-none m-0 tm-lead lg:t-lead" data-node="57:280" data-node-m="63:696">Every engagement is discreet, senior-led, and built around the client’s privacy. References are held in confidence and available on request.</p>
      <div aria-hidden="true" class="hidden lg:block w-full h-px bg-white" data-node="85:3077"></div>
      <ul class="hidden lg:flex m-0 p-0 list-none flex-col gap-[12px] w-full" data-node="85:3078">
        <li class="flex items-start gap-[12px] text-[15px] leading-[24px] font-medium" data-node="85:3079"><Icon name="document" size={20} class="shrink-0" /><span class="flex-1">CA DOI License No. 2B60428</span></li>
        <li class="flex items-start gap-[12px] text-[15px] leading-[24px] font-medium" data-node="85:3084"><Icon name="shield" size={20} class="shrink-0" /><span class="flex-1">No upfront cost. We're paid a percentage of what we recover.</span></li>
      </ul>
    </div>
  </div>
</section>
