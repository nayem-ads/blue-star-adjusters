---
// Major loss: A Major Loss Is More Than a Claim (Figma Homepage v2 482:1567): photo left, navy copy right.
// The Figma AI rental photo is replaced by a real field photo (modern-home: fire-damaged stair beside a house).
import Pic from './Pic.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import { ROUTES } from '../../data/site';
---
<section aria-labelledby="serve-title" class="relative bg-navy text-white overflow-hidden" data-node="57:278" data-node-m="63:694">
  <div class="max-w-[1280px] mx-auto flex flex-col lg:flex-row lg:items-stretch">
    <figure class="relative m-0 h-[300px] lg:h-auto lg:min-h-[640px] lg:w-[520px] lg:shrink-0">
      <Pic d="53:280" m="62:638" alt="Fire-damaged exterior stair and debris beside a white house after a loss." wrap="absolute inset-0" />
      <figcaption class="absolute left-[20px] bottom-[16px] lg:left-[24px] lg:bottom-[20px] t-caption text-white">Field photograph</figcaption>
    </figure>
    <div class="relative flex-1 min-w-0 flex flex-col items-start justify-center gap-[24px] lg:gap-[32px] px-[20px] pt-[48px] pb-[56px] lg:pl-[96px] lg:pr-[80px] lg:py-[120px]" data-node="85:3089">
      <span aria-hidden="true" class="absolute right-[-60px] bottom-[-40px] opacity-[.05] pointer-events-none"><Logo variant="mark-white" bare width={280} height={340} label="" /></span>
      <h2 id="serve-title" class="relative m-0 tm-h2 lg:t-h2 w-full" data-node="57:279" data-node-m="63:695">A Major Loss Is More<br class="hidden lg:inline" /> Than a Claim.</h2>
      <p class="relative m-0 tm-body lg:t-body lg:max-w-[520px]" data-node="57:280" data-node-m="63:696">When a home burns or a building floods, everything happens at once. You may be living in a hotel, keeping a business running from somewhere else, and chasing receipts, all while learning a policy you never had reason to read. The decisions that set your settlement are made in the first few weeks, often before you know what to ask for. We handle the claim so you can look after your family or keep your business running.</p>
      <a href={ROUTES.whoWeServe} class="serve-link relative flex items-center gap-[8px] min-h-[44px] tm-body-strong lg:t-body-strong text-white"><span>Who we serve</span><Icon name="arrow-right" size={24} /></a>
    </div>
  </div>
</section>
<style>
  .serve-link { text-decoration: underline; text-decoration-color: rgb(255 255 255 / .4); text-underline-offset: 4px; transition: text-decoration-color .15s ease; }
  .serve-link:hover, .serve-link:focus-visible { text-decoration-color: currentColor; }
</style>
