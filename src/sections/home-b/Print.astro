---
// Print: a rotated "case file" photo print (white mat, 1px line border, index tab, photo).
// Figma: the frame node is the rotated bounding box (bw×bh); inside it the print (w×h) is centred and rotated by `rot` deg.
// Tab and photo offsets are measured from the print's padding edge (inside the 1px border), exactly as design context gives them.
import Img from '../../components/Img.astro';
interface Props {
  node?: string; photoNode: string; alt: string;
  bw: number; bh: number; w: number; h: number; rot: number;
  pad?: number; tabLeft: number; tabColor: string; tabW?: number; tabH?: number; tabTop?: number;
  class?: string; style?: string; priority?: boolean; bordered?: boolean;
}
const { node, photoNode, alt, bw, bh, w, h, rot, pad = 9, tabLeft, tabColor, tabW = 56, tabH = 12, tabTop, class: cls = '', style = '', priority = false, bordered = true } = Astro.props;
const top = tabTop ?? -(tabH + (bordered ? 1 : 0));
const inner = bordered ? 2 : 0;
---
<div class:list={['flex items-center justify-center', cls]} style={`width:${bw}px;height:${bh}px;${style}`} data-node={node}>
  <div class:list={['relative shrink-0 bg-white box-border', bordered && 'border border-line']} style={`width:${w}px;height:${h}px;transform:rotate(${rot}deg)`}>
    <span aria-hidden="true" class="absolute block rounded-t-[3px]" style={`left:${tabLeft}px;top:${top}px;width:${tabW}px;height:${tabH}px;background:${tabColor}`}></span>
    <Img node={photoNode} alt={alt} priority={priority} class="absolute object-cover max-w-none" style={`left:${pad}px;top:${pad}px;width:${w - inner - 2 * pad}px;height:${h - inner - 2 * pad}px`} />
  </div>
</div>
