---
// How It Works / Five steps. Desktop 128:4402 (1280×2978, zigzag around a centre spine),
// mobile 135:5320 (390×3826, mini timeline + left spine, photo above each step).
// Desktop is truly layered (photos, inset, crop marks and the spine overlap), so each step's photo and
// copy are placed on the 1280 grid with lg:absolute; below lg they flow in one column.
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Pic from './Pic.astro';
import CropMarks from './CropMarks.astro';
import { ROUTES } from '../../data/site';
const stops = [
  { n: '01', label: 'Free Review', m: ['147:1001', '147:1002'], w: 62 },
  { n: '02', label: 'Policy Review', m: ['147:1005', '147:1006'], w: 66 },
  { n: '03', label: 'Scope the Loss', m: ['147:1009', '147:1010'], w: 72 },
  { n: '04', label: 'Build Your Claim', m: ['147:1013', '147:1014'], w: 72 },
  { n: '05', label: 'Maximize Settlement', m: ['147:1017', '147:1018'], w: 78 },
];
const buckets = [
  // [label, desktop id, mobile id, Figma chip width]
  ['Dwelling', '128:4425', '135:5359', 94], ['Other structures', '128:4427', '135:5361', 153], ['Contents', '128:4429', '135:5363', 96],
  ['Loss of use', '128:4431', '135:5365', 110], ['Code upgrades', '128:4433', '135:5367', 142], ['Debris removal', '128:4435', '135:5369', 142],
];
// Desktop spine dots (centre x 640.5) and the connector running out to each step's copy or photo.
const dots = [
  { y: 160.5, cx: 'left-[576px]', cy: 168, d: '128:4649' },
  { y: 738.5, cx: 'left-[648px]', cy: 746, d: '128:4651' },
  { y: 1450.5, cx: 'left-[576px]', cy: 1458, d: '128:4653' },
  { y: 2074.5, cx: 'left-[648px]', cy: 2082, d: '128:4655' },
  { y: 2528.5, cx: 'left-[576px]', cy: 2536, d: '128:4657', solid: true },
];
const numeral = 'hiw-num m-0 font-display font-bold text-[56px] leading-[56px] tracking-[-0.02em] lg:text-[96px] lg:leading-[96px] lg:tracking-[-0.03em] whitespace-nowrap';
const name = 'm-0 mt-[12px] lg:mt-[4px] text-navy tm-h2 lg:t-h2';
const lead = 'm-0 tm-lead lg:t-lead text-ink';
const body = 'm-0 tm-body lg:t-body text-ink';
---
<section aria-label="The five steps" class="relative bg-white lg:h-[2978px]" data-node="128:4402" data-node-m="135:5320">
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[64px] pb-[56px] lg:p-0 lg:h-full">

    <!-- Mobile mini timeline (147:1000): tap a stop to jump to its step. -->
    <nav aria-label="Jump to a step" class="lg:hidden relative flex w-full max-w-[350px] h-[84px]" data-node-m="147:1000">
      <span aria-hidden="true" class="absolute left-[31px] right-[39px] top-[22px] h-px bg-navy/40"></span>
      {stops.map((s, i) => (
        <a href={`#step-${s.n}`} class="hiw-stop relative flex flex-col items-center min-w-0" style={`flex:0 1 ${s.w}px`} data-node-m={s.m[0]}>
          <span class:list={['flex items-center justify-center size-[44px] rounded-full border border-navy box-border font-body font-semibold text-[15px] leading-[20px]', i === 0 ? 'bg-navy text-white' : 'bg-white text-navy']} data-node-m={s.m[1]}>{s.n}</span>
          <span class="mt-[8px] w-full text-center tm-label text-ink">{s.label}</span>
        </a>
      ))}
    </nav>

    <div class="relative mt-[56px] lg:mt-0 lg:static" data-node-m="135:5321">
      <!-- Mobile spine: from the first dot's centre to the last. -->
      <span aria-hidden="true" class="lg:hidden absolute left-[7px] top-[284px] bottom-[316px] w-[2px] bg-royal/30" data-node-m="135:5602"></span>

      <!-- Step 01 -->
      <article class="relative pl-[32px] lg:contents" data-node-m="135:5322">
        <div class="flex flex-col lg:contents" data-node-m="135:5324">
          <div class="w-full h-[224px] lg:absolute lg:left-[704px] lg:top-[144px] lg:w-[496px] lg:h-[344px]" data-node="128:4415" data-node-m="135:5325">
            <Pic d="I128:4415;41:71" m="I135:5325;41:71" alt="Hands at a dining table: a pen on an estimate line beside an open policy and a laptop showing a floor plan." />
          </div>
          <div id="step-01" class="hiw-step mt-[32px] lg:mt-0 lg:absolute lg:left-[80px] lg:top-[120px] lg:w-[480px]" data-node="128:4403">
            <div class="relative" data-node="128:4404">
              <span aria-hidden="true" class="hiw-dot lg:hidden"></span>
              <p aria-hidden="true" class={numeral} style="--w:58px;--wl:98px" data-t="01" data-node="128:4405" data-node-m="135:5330">01</p>
              <h2 class={name} data-node="128:4406" data-node-m="135:5332"><span class="sr-only">Step 1: </span>Free Review.</h2>
            </div>
            <div class="flex flex-col gap-[12px] mt-[16px] lg:mt-[24px]" data-node="128:4407">
              <p class={lead} data-node="128:4408" data-node-m="135:5334">Schedule a free review to discuss your claim with our team at no cost or obligation.</p>
              <p class={body} data-node="128:4409" data-node-m="135:5336">Bring whatever you have. The policy, the carrier’s letters, photos. If we can’t add value, we’ll say so.</p>
            </div>
            <div class="mt-[24px] lg:w-fit" data-node="128:4410" data-node-m="135:5338">
              <Button href={ROUTES.freeClaimReview} variant="outline" class="w-full h-[56px] lg:w-[253px] lg:h-[52px]" data-node="128:4411" data-node-m="135:5339">Schedule a Free Review</Button>
            </div>
          </div>
        </div>
      </article>

      <!-- Step 02 -->
      <article class="relative pl-[32px] mt-[64px] lg:mt-0 lg:contents" data-node-m="135:5344">
        <div class="flex flex-col lg:contents" data-node-m="135:5346">
          <div class="w-full h-[376px] lg:absolute lg:left-[176px] lg:top-[642px] lg:w-[400px] lg:h-[496px]" data-node="128:4438" data-node-m="135:5347">
            <Pic d="I128:4438;41:71" m="I135:5347;41:71" alt="A navy claim binder, loose documents, reading glasses and a pen on a worn wooden table by a window." />
          </div>
          <div id="step-02" class="hiw-step mt-[32px] lg:mt-0 lg:absolute lg:left-[720px] lg:top-[698px] lg:w-[480px]" data-node="128:4418">
            <div class="relative" data-node="128:4419">
              <span aria-hidden="true" class="hiw-dot lg:hidden"></span>
              <p aria-hidden="true" class={numeral} style="--w:68px;--wl:115px" data-t="02" data-node="128:4420" data-node-m="135:5352">02</p>
              <h2 class={name} data-node="128:4421" data-node-m="135:5354"><span class="sr-only">Step 2: </span>Policy Review.</h2>
            </div>
            <div class="flex flex-col gap-[16px] mt-[16px] lg:mt-[24px]" data-node="128:4422">
              <p class={lead} data-node="128:4423" data-node-m="135:5356">We identify all avenues of recovery available under your policy.</p>
              <ul class="m-0 p-0 list-none flex flex-wrap gap-[8px]" data-node="128:4424" data-node-m="135:5358">
                {buckets.map(([t, d, m, w]) => (
                  <li class="px-[12px] py-[8px] lg:py-[4px] rounded-[4px] border border-line bg-paper font-body font-medium text-[15px] leading-[20px] lg:leading-[24px] text-ink whitespace-nowrap box-border" style={`width:${w}px`} data-node={d} data-node-m={m}>{t}</li>
                ))}
              </ul>
              <p class="m-0 tm-body-strong lg:t-body-strong text-ink" data-node="128:4437" data-node-m="135:5372">Each bucket gets measured on its own.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Step 03 -->
      <article class="relative pl-[32px] mt-[64px] lg:mt-0 lg:contents" data-node-m="135:5374">
        <div class="flex flex-col lg:contents" data-node-m="135:5376">
          <div class="relative w-full h-[472px] lg:contents" data-node-m="135:5377">
            <div aria-hidden="true" class="hiw-dim absolute left-0 top-0 w-full lg:left-[768px] lg:top-[1242px] lg:w-[432px]" data-node="128:4455" data-node-m="135:5378">
              <span class="w-px h-[12px] bg-royal shrink-0"></span><span class="flex-1 h-px bg-royal"></span>
              <span class="t-caption text-royal whitespace-nowrap">Measured, not estimated</span>
              <span class="flex-1 h-px bg-royal"></span><span class="w-px h-[12px] bg-royal shrink-0"></span>
            </div>
            <div class="absolute left-0 top-[24px] w-full h-[400px] lg:left-[768px] lg:top-[1274px] lg:w-[432px] lg:h-[536px]" data-node="128:4448" data-node-m="135:5384">
              <Pic d="I128:4448;41:71" m="I135:5384;41:71" alt="An engineer with a headlamp inspects racked, fire-damaged wall framing." />
            </div>
            <div class="hiw-inset absolute right-[-8px] top-[304px] p-[8px] bg-white lg:right-auto lg:left-[680px] lg:top-[1602px]" data-node="128:4451" data-node-m="135:5387">
              <div class="w-[120px] h-[152px] lg:w-[192px] lg:h-[240px]" data-node="128:4452" data-node-m="135:5388">
                <Pic d="I128:4452;41:71" m="I135:5388;41:71" alt="A gloved hand holds a moisture meter against a water-stained wall." />
              </div>
            </div>
          </div>
          <div id="step-03" class="hiw-step mt-[32px] lg:mt-0 lg:absolute lg:left-[80px] lg:top-[1410px] lg:w-[480px]" data-node="128:4441">
            <div class="relative" data-node="128:4442">
              <span aria-hidden="true" class="hiw-dot lg:hidden"></span>
              <p aria-hidden="true" class={numeral} style="--w:69px;--wl:116px" data-t="03" data-node="128:4443" data-node-m="135:5393">03</p>
              <h2 class={name} data-node="128:4444" data-node-m="135:5395"><span class="sr-only">Step 3: </span>Scope the Loss.</h2>
            </div>
            <div class="flex flex-col gap-[12px] mt-[16px] lg:mt-[24px]" data-node="128:4445">
              <p class={lead} data-node="128:4446" data-node-m="135:5397">We participate in determining the full scope of your loss from day one.</p>
              <p class={body} data-node="128:4447" data-node-m="135:5399">Moisture mapping, industrial hygiene testing, and structural review where the loss calls for it.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Step 04 -->
      <article class="relative pl-[32px] mt-[64px] lg:mt-0 lg:contents" data-node-m="135:5558">
        <div class="flex flex-col lg:contents" data-node-m="135:5560">
          <div class="relative w-full h-[240px] lg:contents" data-node-m="135:5561">
            <CropMarks class="hidden lg:block absolute lg:left-[64px] lg:top-[1986px] lg:w-[528px] lg:h-[368px]" node="128:4624" />
            <div class="w-full h-full lg:absolute lg:left-[80px] lg:top-[2002px] lg:w-[496px] lg:h-[336px]" data-node="128:4621" data-node-m="135:5571">
              <Pic d="I128:4621;41:71" m="I135:5571;41:71" alt="Top-down view of an open claim binder with photo sheets, a moisture map and a floor plan." />
            </div>
          </div>
          <div id="step-04" class="hiw-step mt-[32px] lg:mt-0 lg:absolute lg:left-[720px] lg:top-[2034px] lg:w-[480px]" data-node="128:4615">
            <div class="relative" data-node="128:4616">
              <span aria-hidden="true" class="hiw-dot lg:hidden"></span>
              <p aria-hidden="true" class={numeral} style="--w:70px;--wl:119px" data-t="04" data-node="128:4617" data-node-m="135:5576">04</p>
              <h2 class={name} data-node="128:4618" data-node-m="135:5578"><span class="sr-only">Step 4: </span>Build Your Claim.</h2>
            </div>
            <div class="mt-[16px] lg:mt-[24px]" data-node="128:4619">
              <p class={lead} data-node="128:4620" data-node-m="135:5580">We prepare and present a detailed, itemized claim package on your behalf, with your approval.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Step 05 -->
      <article class="relative pl-[32px] mt-[64px] lg:mt-0 lg:contents" data-node-m="135:5582">
        <div class="flex flex-col lg:contents" data-node-m="135:5584">
          <div class="w-full h-[232px] lg:absolute lg:left-[704px] lg:top-[2490px] lg:w-[496px] lg:h-[368px]" data-node="128:4644" data-node-m="135:5585">
            <Pic d="I128:4644;41:71" m="I135:5585;41:71" alt="A long conference table with two sets of documents facing each other and a city view beyond." />
          </div>
          <div id="step-05" class="hiw-step mt-[32px] lg:mt-0 lg:absolute lg:left-[80px] lg:top-[2488px] lg:w-[480px]" data-node="128:4633">
            <div class="relative" data-node="128:4634">
              <span aria-hidden="true" class="hiw-dot hiw-dot--solid lg:hidden"></span>
              <p aria-hidden="true" class={numeral} style="--w:70px;--wl:119px" data-t="05" data-node="128:4635" data-node-m="135:5590">05</p>
              <h2 class={name} data-node="128:4636" data-node-m="135:5592"><span class="sr-only">Step 5: </span>Maximize Settlement.</h2>
            </div>
            <div class="flex flex-col gap-[20px] mt-[16px] lg:gap-[16px] lg:mt-[24px]" data-node="128:4637">
              <p class={lead} data-node="128:4638" data-node-m="135:5594">We negotiate proactively to get you the most money as fast as possible.</p>
              <p class="m-0 flex items-start gap-[12px] pl-[16px] pr-[16px] py-[16px] lg:items-center lg:gap-[16px] lg:pl-[20px] lg:pr-[24px] lg:py-[20px] bg-paper border-l-[3px] border-royal" data-node="128:4639" data-node-m="135:5596">
                <Icon name="shield" size={24} class="shrink-0 text-navy" />
                <span class="flex-1 min-w-0 tm-body-strong lg:t-body-strong text-ink" data-node="128:4643" data-node-m="135:5600">You always have final say on any settlement.</span>
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- Desktop spine, connectors and dots. -->
      <div aria-hidden="true" class="hidden lg:block">
        <span class="absolute left-[640px] top-[168px] w-px h-[2368px] bg-navy" data-node="128:4647"></span>
        {dots.map((d) => (
          <>
            <span class={`absolute ${d.cx} w-[56px] h-px bg-navy`} style={`top:${d.cy}px`}></span>
            <svg class="absolute left-[632.5px]" style={`top:${d.y}px`} width="16" height="16" viewBox="0 0 16 16" data-node={d.d}>
              <circle cx="8" cy="8" r="7.25" fill={d.solid ? '#081d5e' : '#fff'} stroke="#081d5e" stroke-width="1.5" />
            </svg>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  /* Figma strokes the numerals outside the glyph (1.5px): draw a 3px centred stroke, then cover its inner half with a white copy. */
  .hiw-num { position: relative; width: var(--w); color: transparent; -webkit-text-stroke: 3px var(--color-royal); }
  .hiw-num::after { content: attr(data-t); position: absolute; left: 0; top: 0; color: #fff; -webkit-text-stroke: 0; }
  @media (min-width: 1024px) { .hiw-num { width: var(--wl); } }
  .hiw-step { scroll-margin-top: 96px; }
  .hiw-dim { display: flex; align-items: center; gap: 8px; height: 16px; }
  .hiw-inset { box-shadow: 0 8px 12px 0 rgba(8, 15, 51, .16); }
  @media (min-width: 1024px) { .hiw-inset { box-shadow: 0 12px 32px 0 rgba(8, 15, 51, .18); } }
  /* Mobile rail dot: 16px, centred on the numeral, on the spine 32px to the left. */
  .hiw-dot { position: absolute; left: -32px; top: 20px; width: 16px; height: 16px; border-radius: 50%; box-sizing: border-box; border: 1.5px solid var(--color-royal); background: #fff; }
  .hiw-dot--solid { background: var(--color-navy); border-color: var(--color-navy); }
  .hiw-stop:hover > span:first-child { box-shadow: 0 0 0 2px var(--color-line); }
</style>
