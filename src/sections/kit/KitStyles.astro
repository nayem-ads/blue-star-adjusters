---
// Content kit shared styles (link look matches body links across the site).
---
<style is:global>
  .bs-kit-link { color: var(--color-royal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .bs-kit-link:hover { color: var(--color-navy); text-decoration-thickness: 2px; }
  .bs-kit-prose p + p { margin-top: 16px; }
  @media (min-width: 1024px) { .bs-kit-prose p + p { margin-top: 20px; } }
</style>
