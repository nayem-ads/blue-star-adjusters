---
// State licenses and rules (navy ledger). Desktop 217:8010, mobile 217:11855 (approved copy 2026-10-16).
// Margin rail (§ 02, 6 states) | H2, intro, firm license table, then one rule per state (source chip + H3 | copy).
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
const licenses = [
  { state: 'California', no: '6015234', offices: 'Sacramento, Santa Monica, San Francisco' },
  { state: 'Nevada', no: '4263596', offices: 'Reno' },
  { state: 'Oregon', no: '3004448214', offices: 'Portland' },
  { state: 'Washington', no: '1382428', offices: 'Seattle' },
  { state: 'Arizona', no: '3004469742', offices: 'Scottsdale' },
  { state: 'Colorado', no: '969283', offices: 'Colorado line' },
];
const head = ['State', 'Firm license No.', 'Offices'];
const rules = [
  { title: 'California. Your Right to Cancel.', src: 'Cal. Ins. Code 15027 and 15027.1', body: [
    'You may cancel within three business days of signing and receiving the contract, or five calendar days if your property is in a declared catastrophic disaster area. Our fee can never leave you with less than your insurer had already paid before you hired us.',
    "In an area hit by a catastrophic disaster, a public adjuster can't solicit a homeowner until seven calendar days after the loss producing event ends. That rule doesn't apply when you call us first.",
  ], d: '217:8018', m: '217:11867' },
  { title: 'Nevada. No Legal Advice.', src: 'NRS 684A.165', body: [
    'Nevada law bars adjusters from giving legal advice. When your claim needs counsel, we work alongside your attorney.',
  ], d: '217:8041', m: '217:11890' },
  { title: 'Oregon. Check Before You Sign.', src: 'Oregon Division of Financial Regulation', body: [
    'Oregon licenses adjusters through its Division of Financial Regulation. Our firm license is 3004448214. Look it up with the Division before you sign anything.',
  ], d: '217:8054', m: '217:11903' },
  { title: 'Washington. Underinsurance Is Common.', src: 'Washington Office of the Insurance Commissioner', body: [
    "After the August 2023 Gray and Oregon Road fires, the Commissioner's review found 244 of 355 significant dwelling claims paid out their full limits. The 169 homes with extended replacement cost coverage recovered more than the policy limit. That is why we read the whole policy, endorsements included, before we scope the loss.",
  ], d: '217:8067', m: '217:11916' },
  { title: 'Arizona. We Measure. Your Contractor Builds.', src: 'ARS 20-321.02', body: [
    'Arizona bars adjusters from taking any part, directly or indirectly, in repairing property on a claim they adjust. We measure and negotiate. Your contractor builds.',
  ], d: '217:8080', m: '217:11929' },
];
---
<section aria-labelledby="loc-rules-title" class="lc-rules relative overflow-hidden bg-navy text-white" data-node="217:8010" data-node-m="217:11855">
  <span aria-hidden="true" class="hidden lg:block absolute left-[calc(50%-760px)] bottom-[120px] opacity-[.07] pointer-events-none" data-node="217:8974"><Logo variant="mark-white" bare width={428.294} height={520} label="" /></span>
  <span aria-hidden="true" class="lg:hidden absolute left-[199.7px] bottom-[80px] opacity-[.06] pointer-events-none" data-node-m="217:11856"><Logo variant="mark-white" bare width={345.9} height={420} label="" /></span>

  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[56px] pb-[56px] lg:px-[80px] lg:py-[120px] lg:flex lg:items-start lg:gap-[64px]">
    <!-- Desktop margin rail / mobile index row -->
    <div class="hidden lg:flex flex-col items-start gap-[16px] w-[256px] shrink-0" data-node="217:8011">
      <p class="m-0 t-label whitespace-nowrap" data-node="217:8012">§ 02</p>
      <span aria-hidden="true" class="block w-[256px] h-px bg-white opacity-40"></span>
      <p class="m-0 border border-white rounded-[2px] px-[8px] py-[4px] t-label whitespace-nowrap" data-node="217:8014">6 states</p>
    </div>
    <div class="lg:hidden flex items-start gap-[12px] h-[50px]" data-node-m="217:11861">
      <p class="m-0 mt-[5px] tm-label whitespace-nowrap" data-node-m="217:11862">§ 02</p>
      <span aria-hidden="true" class="flex-1 h-[2px] mt-[12px] bg-white opacity-[.174]"></span>
      <p class="m-0 border border-white rounded-[2px] px-[8px] py-[4px] tm-label whitespace-nowrap" data-node-m="217:11864">6 states</p>
    </div>

    <div class="lg:flex-1 lg:min-w-0" data-node="217:8016">
      <h2 id="loc-rules-title" class="m-0 mt-[8px] lg:mt-0 tm-h2 lg:t-h2">Licensed Public Adjusters in California and Five More States.</h2>
      <p class="m-0 mt-[16px] lg:mt-[24px] tm-body lg:t-lead opacity-90">Blue Star Adjusters LLC holds a public adjusting firm license in each state below. Each state writes its own rules for public adjusters. Here is one worth knowing in each.</p>

      <!-- Firm licenses: desktop table, mobile rows -->
      <table class="hidden lg:table mt-[40px] w-full border-collapse text-left">
        <thead><tr class="border-b-2 border-white">{head.map((h) => <th scope="col" class="t-label py-[12px] pr-[24px] align-bottom">{h}</th>)}</tr></thead>
        <tbody>
          {licenses.map((l) => (
            <tr class="border-b border-white/25">
              <th scope="row" class="t-body-strong py-[14px] pr-[24px] align-top w-[200px]">{l.state}</th>
              <td class="t-body py-[14px] pr-[24px] align-top w-[200px] tabular-nums">{l.no}</td>
              <td class="t-body py-[14px] align-top">
                <span class="flex items-start gap-[8px]"><Icon name="map-pin" size={16} class="shrink-0 mt-[4px]" />{l.offices}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="lg:hidden m-0 mt-[32px] p-0 list-none border-t-2 border-white">
        {licenses.map((l) => (
          <li class="border-b border-white/25 py-[14px] flex flex-col gap-[6px]">
            <div class="flex items-baseline justify-between gap-[12px]">
              <p class="m-0 tm-body-strong">{l.state}</p>
              <p class="m-0 tm-body tabular-nums">{l.no}</p>
            </div>
            <p class="m-0 flex items-start gap-[8px] tm-body opacity-90"><Icon name="map-pin" size={16} class="shrink-0 mt-[4px]" />{l.offices}</p>
          </li>
        ))}
      </ul>

      <div class="mt-[48px] lg:mt-[72px]">
        {rules.map((r) => (
          <>
            <span aria-hidden="true" class="block h-px bg-white/25"></span>
            <article class="pt-[24px] pb-[28px] lg:py-[32px] lg:flex lg:items-start lg:gap-[32px]" data-node={r.d} data-node-m={r.m}>
              <div class="flex flex-col items-start gap-[12px] lg:w-[280px] lg:shrink-0">
                <p class="m-0 border border-white rounded-[2px] px-[8px] py-[4px] tm-label lg:t-label">{r.src}</p>
                <h3 class="m-0 tm-h3 lg:t-h3">{r.title}</h3>
              </div>
              <div class="mt-[12px] lg:mt-0 lg:flex-1 lg:min-w-0 flex flex-col gap-[12px] lg:gap-[16px]">
                {r.body.map((p) => <p class="m-0 tm-body lg:t-body">{p}</p>)}
              </div>
            </article>
          </>
        ))}
        <span aria-hidden="true" class="block h-px bg-white/25" data-node="217:8092" data-node-m="217:11941"></span>
      </div>
    </div>
  </div>
</section>
