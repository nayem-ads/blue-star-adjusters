---
// Local line (Santa Monica, San Francisco only). Paper band: pin + state chip rail, royal lead rule, Schibsted Medium line.
import Icon from '../../components/Icon.astro';
import Chip from './Chip.astro';
import { nodes, type OfficeData } from './types';
interface Props { data: OfficeData }
const { data: d } = Astro.props;
const n = (k: string) => nodes(d, k);
const id = (k: string, i: 0 | 1) => d.n[k]?.[i] ?? undefined;
---
<section aria-label={`${d.city} local note`} class="bg-paper" {...n('local')}>
  <div class="max-w-[1280px] mx-auto flex flex-col gap-[24px] px-[20px] pt-[64px] pb-[56px] lg:flex-row lg:items-start lg:gap-[112px] lg:px-[80px] lg:py-[96px]">
    <div class="flex flex-col gap-[16px] lg:w-[264px] lg:shrink-0" {...n('local.rail')}>
      <div class="flex items-center gap-[12px]" {...n('local.marker')}>
        <span aria-hidden="true" class="flex items-center justify-center shrink-0 size-[42px] rounded-full border border-navy text-navy lg:size-[48px] lg:border-0 lg:bg-paper" {...n('local.icon')}><Icon name="map-pin" size={24} /></span>
        <Chip class="border border-navy text-navy" node={id('local.chip', 0)} nodeM={id('local.chip', 1)} textNode={id('local.chipt', 0)} textNodeM={id('local.chipt', 1)}>{d.state}</Chip>
      </div>
      <span aria-hidden="true" class="hidden lg:block h-px w-full bg-line" {...n('local.railRule')}></span>
    </div>
    <div class="flex flex-col gap-[24px] lg:w-[744px] lg:shrink-0" {...n('local.leadWrap')}>
      <span aria-hidden="true" class="block h-[4px] w-[40px] lg:w-[48px] bg-royal" {...n('local.leadRule')}></span>
      <p class="bs-office-local m-0 text-navy" {...n('local.lead')}>{d.local}</p>
    </div>
  </div>
</section>
<style>
  .bs-office-local { font-family: var(--font-display); font-weight: 500; font-size: 26px; line-height: 34px; letter-spacing: -0.01em; }
  @media (min-width: 1024px) { .bs-office-local { font-size: 36px; line-height: 44px; } }
</style>
