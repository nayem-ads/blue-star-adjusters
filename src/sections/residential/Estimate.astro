---
// Residential "Section / Estimate". Desktop 228:891 (1280×975), mobile 228:1023 (390×1131).
// Navy, faint white B-mark (6%), oversized lead as H2, eight-item list (2 columns desktop, 1 column mobile), on-dark CTA.
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { ROUTES } from '../../data/site';

const cols = [
  [
    { text: 'Fire, wildfire and smoke losses', icon: 'flame', d: ['228:908', '228:909', '228:913'], m: ['228:1038', '228:1039', '228:1043'] },
    { text: 'Water and plumbing failures', icon: 'droplet', d: ['228:915', '228:916', '228:919'], m: ['228:1045', '228:1046', '228:1049'] },
    { text: 'Trees and falling object damage', icon: 'wind', d: ['228:921', '228:922', '228:925'], m: ['228:1051', '228:1052', '228:1055'] },
    { text: 'Collapse: snow load and structural', icon: 'home', d: ['228:927', '228:928', '228:932'], m: ['228:1057', '228:1058', '228:1062'] },
  ],
  [
    { text: 'Ordinance or law and code upgrades', icon: 'ruler', d: ['228:934', '228:935', '228:939'], m: ['228:1064', '228:1065', '228:1069'] },
    { text: 'Contents valuation and inventory', icon: 'document', d: ['228:941', '228:942', '228:946'], m: ['228:1071', '228:1072', '228:1076'] },
    { text: 'Additional living expenses (ALE)', icon: 'clock', d: ['228:948', '228:949', '228:953'], m: ['228:1078', '228:1079', '228:1083'] },
    { text: 'Lead, asbestos and mold remediation analysis', icon: 'search', d: ['228:955', '228:956', '228:960'], m: ['228:1085', '228:1086', '228:1090'] },
  ],
];
---
<section aria-labelledby="res-estimate-title" class="relative bg-navy overflow-hidden" data-node="228:891" data-node-m="228:1023">
  <div class="relative max-w-[1280px] mx-auto">
    <svg aria-hidden="true" class="res-mark absolute left-[193.4px] top-[40px] w-[280.8px] h-[340.9px] lg:left-[911px] lg:top-[80px] lg:w-[461.2px] lg:h-[560px]" viewBox="0 0 216 262.25" fill="none" data-node="228:896" data-node-m="228:1028">
      <path d="M0.25 28.25L59 0.25V259.75L0.25 232.25V28.25Z" fill="white"/>
      <path d="M75.75 195L157.25 162.55L216 188.75V211.25L75.75 262.25V195Z" fill="white"/>
      <path d="M75.75 0L182.75 50.75V113.25L75.75 62V0Z" fill="white" fill-opacity="0.7"/>
      <path d="M75.75 85L216 153.25V188.75L75.75 126.25V85Z" fill="white" fill-opacity="0.7"/>
    </svg>

    <div class="relative flex flex-col items-start px-[20px] pt-[64px] pb-[64px] gap-[32px] lg:px-[80px] lg:py-[120px] lg:gap-[56px]">
      <div class="inline-flex border border-white rounded-[2px] px-[8px] py-[4px]" data-node="228:901" data-node-m="228:1033">
        <span class="tm-label lg:t-label text-white whitespace-nowrap" data-node="228:902" data-node-m="228:1034">§ 03</span>
      </div>

      <h2 id="res-estimate-title" class="m-0 w-full lg:w-[864px] tm-h2 lg:t-h2 text-white" data-node="228:903" data-node-m="228:1035">Your insurer's adjuster already came out? Good. We start from their estimate and measure what it left out.</h2>

      <div class="flex flex-col w-full lg:flex-row lg:gap-[48px] lg:items-start" data-node="228:904" data-node-m="228:1036">
        {cols.map((col, ci) => (
          <ul class:list={['res-est-col m-0 p-0 list-none flex flex-col flex-1 min-w-0', ci === 0 ? 'res-est-col--first' : '']} data-node={ci === 0 ? '228:905' : '228:906'}>
            {col.map((it) => (
              <li class="res-est-item flex items-center gap-[16px] py-[16px] lg:py-[20px]" data-node={it.d[0]} data-node-m={it.m[0]}>
                <span class="flex items-center justify-center shrink-0 size-[40px] rounded-full bg-navy border border-white text-white" data-node={it.d[1]} data-node-m={it.m[1]}>
                  <Icon name={it.icon} size={24} />
                </span>
                <span class="flex-1 min-w-0 tm-body-strong lg:t-lead text-white" data-node={it.d[2]} data-node-m={it.m[2]}>{it.text}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>

      <Button href={ROUTES.freeClaimReview} variant="on-dark" class="h-[56px] w-full lg:h-[52px] lg:w-auto" node="228:963" data-node-m="228:1092">Schedule a Free Review</Button>
    </div>
  </div>
</section>
<style>
  .res-mark { opacity: .06; pointer-events: none; }
  /* Hairlines: white at 24%, one above each item and one closing each column (mobile: one continuous list). */
  .res-est-item { border-top: 1px solid rgb(255 255 255 / .24); }
  .res-est-col { border-bottom: 1px solid rgb(255 255 255 / .24); }
  @media (max-width: 1023.98px) { .res-est-col--first { border-bottom: 0; } }
</style>
