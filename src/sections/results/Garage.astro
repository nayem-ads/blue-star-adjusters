---
// Results / Result: Garage fire, total loss (navy). Desktop 217:8598 (1280×604), mobile 217:12055 (390×651).
import Logo from '../../components/Logo.astro';
import IconCircle from './IconCircle.astro';
import Ticks from './Ticks.astro';
const disclaimer = 'Results reflect specific losses and policies. Past results don’t guarantee a similar outcome.';
---
<section aria-labelledby="garage-title" class="relative overflow-hidden bg-navy text-white" data-node="217:8598" data-node-m="217:12055">
  <span aria-hidden="true" class="hidden lg:block absolute left-[calc(50%+204.7px)] top-[148px] opacity-[.07] pointer-events-none" data-node="217:8622"><Logo variant="mark-white" bare width={395.348} height={480} label="" /></span>
  <span aria-hidden="true" class="lg:hidden absolute left-[226.6px] top-[395px] opacity-[.07] pointer-events-none" data-node-m="217:12056"><Logo variant="mark-white" bare width={263.565} height={320} label="" /></span>
  <Ticks class="hidden lg:block absolute left-0 right-0 top-0 text-white opacity-30" node="217:8627" />

  <!-- desktop -->
  <div class="hidden lg:flex relative max-w-[1280px] mx-auto px-[80px] py-[120px] gap-[96px] items-start">
    <div class="w-[648px] shrink-0 flex flex-col gap-[32px]" data-node="217:8599">
      <div class="flex items-center gap-[16px] self-start" data-node="217:8600">
        <span aria-hidden="true" class="block w-[40px] h-px bg-white"></span>
        <h2 id="garage-title" class="m-0 t-body-strong whitespace-nowrap" data-node="217:8602">Garage fire, total loss.</h2>
        <span aria-hidden="true" class="block w-[40px] h-px bg-white"></span>
      </div>
      <p class="m-0 flex items-baseline gap-[16px] self-start" data-node="217:8604">
        <span class="w-[112px] shrink-0 t-small font-medium">Offer</span>
        <span class="t-h2 whitespace-nowrap pr-[1.7px]" data-node="217:8606">denied</span>
      </p>
      <p class="m-0 flex items-baseline gap-[16px]" data-node="217:8607">
        <span class="w-[112px] shrink-0 t-small font-medium">Result</span>
        <span class="flex-1 min-w-0 t-display-l" data-node="217:8609">$1.4M loss, not recoverable.</span>
      </p>
      <div class="pl-[128px] flex flex-col gap-[12px]" data-node="217:8610">
        <span aria-hidden="true" class="block w-[24px] h-[2px] bg-white"></span>
        <p class="m-0 font-body font-medium text-[12px] leading-[18px] opacity-90" data-node="217:8612">{disclaimer}</p>
      </div>
    </div>
    <div class="flex-1 min-w-0 flex flex-col items-start gap-[24px]" data-node="217:8613">
      <IconCircle name="flame" class="border-white text-white" node="217:8614" />
      <p class="m-0 t-body-strong whitespace-nowrap" data-node="217:8618">What made the difference:</p>
      <p class="m-0 t-lead" data-node="217:8619">welding for a business in the garage. The policy excluded business operations.</p>
      <span aria-hidden="true" class="block w-[48px] h-px bg-white opacity-60"></span>
      <p class="m-0 t-h3" data-node="217:8621">We explained why before the client spent a dollar.</p>
    </div>
  </div>

  <!-- mobile -->
  <div class="lg:hidden relative px-[20px] pt-[56px] pb-[64px]">
    <div class="flex w-fit items-center gap-[12px]" data-node-m="217:12061">
      <span aria-hidden="true" class="block w-[24px] h-px bg-white"></span>
      <h2 class="m-0 tm-body-strong whitespace-nowrap" data-node-m="217:12063">Garage fire, total loss.</h2>
      <span aria-hidden="true" class="block w-[24px] h-px bg-white"></span>
    </div>
    <p class="m-0 mt-[24px] flex flex-col gap-[4px]" data-node-m="217:12065">
      <span class="tm-label">Offer</span>
      <span class="font-display font-semibold text-[32px] leading-[36px] tracking-[-0.015em] self-start" data-node-m="217:12067">denied</span>
    </p>
    <div class="mt-[24px]" data-node-m="217:12068">
      <p class="m-0 flex flex-col gap-[4px]">
        <span class="tm-label">Result</span>
        <span class="tm-display" data-node-m="217:12070">$1.4M loss, not recoverable.</span>
      </p>
      <p class="m-0 mt-[4px] font-body font-medium text-[12px] leading-[18px] opacity-90" data-node-m="217:12071">{disclaimer}</p>
    </div>
    <span aria-hidden="true" class="block mt-[24px] h-px bg-white opacity-20"></span>
    <div class="mt-[24px] flex w-fit items-center gap-[12px]" data-node-m="217:12073">
      <IconCircle name="search" class="border-white text-white" />
      <p class="m-0 tm-body-strong" data-node-m="217:12078">What made the difference:</p>
    </div>
    <p class="m-0 mt-[24px] tm-body" data-node-m="217:12079">welding for a business in the garage. The policy excluded business operations.</p>
    <p class="m-0 mt-[24px] border-l-2 border-white pl-[16px] tm-h3" data-node-m="217:12080">We explained why before the client spent a dollar.</p>
  </div>
</section>
