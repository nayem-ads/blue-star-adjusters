---
// Results / Hero. Desktop 217:6219 (1280×693, paper, blueprint grid, ruler at the bottom edge), mobile 217:11663 (390×448).
// H1 + direct answer (lead), CTAs, then the trust facts (desktop in the white card that held the ledger key; mobile stacked under the CTAs).
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Icon from '../../components/Icon.astro';
import Grid from './Grid.astro';
import Ticks from './Ticks.astro';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../data/site';
const facts = [
  { icon: 'check', text: 'No upfront cost', node: '217:6237', t: '217:6240' },
  { icon: 'shield', text: 'You always have final say on any settlement', node: '217:6241', t: '217:6245' },
  { icon: 'document', text: 'CA DOI License No. 6015234', node: '217:6246', t: '217:6250' },
];
const lead = 'How much more do public adjusters get? There is no fixed number. A Florida state study of Citizens Property Insurance claims from 2008 and 2009 found that claims with a public adjuster paid more before fees, and took longer to settle. On our own claims, the difference came from what the first estimate left out. Below are five results, including a denial we could not overturn.';
---
<section aria-labelledby="results-title" class="relative overflow-hidden bg-paper" data-node="217:6219" data-node-m="217:11663">
  <Grid />
  <div class="relative max-w-[1280px] mx-auto px-[20px] pt-[32px] pb-[40px] lg:px-[80px] lg:pt-[96px] lg:pb-[112px]">
    <div class="flex flex-col gap-[20px] lg:gap-[24px]" data-node="217:6220">
      <Eyebrow class="self-start" node="217:6221">Claim Results</Eyebrow>
      <h1 id="results-title" class="m-0 tm-display lg:t-display-l text-navy lg:max-w-[880px]" data-node="217:6224" data-node-m="217:11667">How Much More Do Public Adjusters Get?</h1>
    </div>
    <div class="mt-[20px] lg:mt-[48px] flex flex-col lg:flex-row lg:items-end lg:gap-[96px]" data-node="217:6225">
      <div class="flex-1 min-w-0 flex flex-col gap-[24px] lg:gap-[40px]" data-node="217:6226">
        <p class="m-0 tm-lead lg:t-lead text-ink lg:max-w-[640px]">{lead}</p>
        <div class="flex flex-col gap-[12px] pt-[4px] lg:pt-0 lg:flex-row lg:gap-[16px] lg:self-start" data-node="217:6227" data-node-m="217:11668">
          <Button href={ROUTES.freeClaimReview} class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]" node="217:6228" data-node-m="217:11669">Schedule a Free Review</Button>
          <Button href={PHONE_TEL} variant="outline" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[235px]" node="217:6232" data-node-m="217:11673">Call {PHONE_DISPLAY}</Button>
        </div>
      </div>
      <ul class="m-0 mt-[24px] lg:mt-0 p-0 list-none flex flex-col lg:w-[360px] lg:shrink-0 lg:px-[32px] lg:py-[20px] lg:bg-white lg:border lg:border-line" data-node="217:6236">
        {facts.map((f, i) => (
          <li class:list={['flex items-center gap-[12px] lg:gap-[16px] pt-[13px] pb-[11px] lg:py-[12px] tm-body lg:t-small lg:font-medium text-ink', i > 0 ? 'border-t border-line' : 'border-t border-line lg:border-t-0']} data-node={f.node}>
            <Icon name={f.icon} size={24} class="shrink-0 text-navy" /><span class="flex-1 min-w-0" data-node={f.t}>{f.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <Ticks anchor="bottom" class="absolute left-0 right-0 bottom-0 text-navy opacity-50" node="217:6308" nodeM="217:11700" />
</section>
