---
// What We Do / Callouts. Desktop 74:707 (1280×1376), mobile 74:4138 (390×2130).
// Left: Code upgrades callout. Right: results (What the Carrier Offered. What We Recovered.).
import Img from '../../components/Img.astro';
import ArrowLink from './ArrowLink.astro';
import CropMarks from './CropMarks.astro';
import { ROUTES } from '../../data/site';
const code = [
  { lead: 'What the city will require:', rest: ' energy code, fire sprinklers, accessibility, seismic bracing.', d: ['74:730', '74:731'], m: ['74:4160', '74:4161'] },
  { lead: 'Undamaged portions', rest: ' that must come up to code because the damaged part does.', d: ['74:733', '74:734'], m: ['74:4163', '74:4164'] },
  { lead: 'Where the money is:', rest: ' ordinance or law coverage (often an endorsement, with its own limit), demolition, increased cost of construction.', d: ['74:736', '74:737'], m: ['74:4166', '74:4167'] },
];
const disclaimer = "Results reflect specific losses and policies. Past results don't guarantee a similar outcome.";
---
<section aria-labelledby="wwd-code-title" class="bg-white" data-node="74:707" data-node-m="74:4138">
  <div class="max-w-[1280px] mx-auto flex flex-col gap-[24px] px-[20px] pt-[64px] pb-[56px] lg:flex-row lg:items-start lg:gap-[64px] lg:px-[80px] lg:py-[120px]">
    <!-- Code upgrades -->
    <div class="flex flex-col items-start gap-[24px] w-full lg:flex-[0_1_640px] lg:min-w-0" data-node="74:708">
      <div class="relative w-full h-[288px] lg:h-[424px]" data-node="74:709" data-node-m="74:4139">
        <div class="absolute left-[6px] top-[6px] right-[6px] bottom-[6px] lg:left-[12px] lg:top-[12px] lg:right-[12px] lg:bottom-[12px]" data-node="74:710" data-node-m="74:4140">
          <Img node="74:4140" alt="Exposed structural framing at a stair, opened up for inspection" class="lg:hidden w-full h-full object-cover" />
          <Img node="74:710" alt="Exposed structural framing at a stair, opened up for inspection" class="hidden lg:block w-full h-full object-cover" />
        </div>
        <CropMarks class="absolute inset-0" node="74:711" nodeM="74:4141" />
      </div>
      <h2 id="wwd-code-title" class="m-0 w-full text-navy tm-h3 lg:t-h3" data-node="74:726" data-node-m="74:4156">You Can't Rebuild It the Way It Was. The City Won't Let You.</h2>
      <p class="m-0 w-full text-ink tm-body lg:t-body" data-node="74:727" data-node-m="74:4157">We identify and quantify code upgrade costs that may be covered under your policy, a significant source of recovery that most homeowners don't know they have, and the carrier's first estimate rarely includes.</p>
      <ul class="m-0 p-0 list-none w-full border-t border-line" data-node="74:728" data-node-m="74:4158">
        {code.map((c) => (
          <li class="py-[16px] border-b border-line" data-node={c.d[0]} data-node-m={c.m[0]}>
            <p class="m-0 text-ink tm-body lg:t-body" data-node={c.d[1]} data-node-m={c.m[1]}><strong class="font-semibold">{c.lead}</strong>{c.rest}</p>
          </li>
        ))}
      </ul>
      <p class="m-0 w-full text-ink tm-lead lg:t-lead lg:pt-[8px]" data-node="74:741" data-node-m="74:4171">That limit is printed in your policy. We read it before the scope is written, so the code work is priced against money that's actually there.</p>
      <ArrowLink href={ROUTES.codeUpgrades} class="min-h-[44px] lg:min-h-0" labelClass="tm-body-strong lg:font-medium lg:text-[15px] lg:leading-[20px]">Ordinance or law coverage</ArrowLink>
    </div>

    <!-- Results -->
    <div class="flex flex-col items-start gap-[16px] w-full pt-[32px] lg:gap-[20px] lg:pt-0 lg:flex-[0_1_416px] lg:min-w-0" data-node="74:742" data-node-m="74:4172">
      <div class="w-full h-[260px] lg:h-[240px]" data-node="74:743" data-node-m="74:4173">
        <Img node="74:4173" alt="Household contents laid out for a room-by-room inventory" class="lg:hidden w-full h-full object-cover" />
        <Img node="74:743" alt="Household contents laid out for a room-by-room inventory" class="hidden lg:block w-full h-full object-cover" />
      </div>
      <div class="w-full h-[2px] bg-navy shrink-0" data-node="74:744" data-node-m="74:4174"></div>
      <h2 id="wwd-results-title" class="m-0 w-full text-navy tm-h3 lg:t-h3" data-node="74:745" data-node-m="74:4175">What the Carrier Offered. What We Recovered.</h2>
      <div class="flex flex-col items-start gap-[8px] w-full pt-[16px] border-t border-line lg:pt-[20px]" data-node="74:1778" data-node-m="74:4189">
        <p class="m-0 w-full text-ink font-body font-semibold text-[16px] leading-[26px] lg:text-[15px] lg:leading-[24px]" data-node="74:1779" data-node-m="74:4190">Los Angeles house fire, full strip out.</p>
        <div class="flex flex-col items-start gap-[12px] w-full" data-node="74:1780">
          <p class="m-0 flex flex-col gap-[4px]"><span class="text-ink tm-label lg:t-label">Offered</span> <s class="text-ink tm-h3 lg:t-h3" data-node="74:1781" data-node-m="74:4191">$38,000</s></p>
          <p class="m-0 flex flex-col gap-[4px]"><span class="text-ink tm-label lg:t-label">Settled at</span> <span class="text-navy tm-figure lg:t-figure whitespace-nowrap" data-node="74:1783" data-node-m="74:4192">$276,000</span></p>
        </div>
      </div>
      <div class="flex flex-col items-start gap-[8px] w-full pt-[16px] border-t border-line lg:pt-[20px]" data-node="74:752" data-node-m="74:4182">
        <p class="m-0 w-full text-ink font-body font-semibold text-[16px] leading-[26px] lg:text-[15px] lg:leading-[24px]">Estate fire, fine wine and art.</p>
        <p class="m-0 w-full text-ink tm-body lg:t-body" data-node="74:751" data-node-m="74:4181">The owner recovered $6 million on his own, then the claim stalled on the fine wine and art. With Blue Star, the structure settled at $11 million, with $5.2 million more for contents.</p>
      </div>
      <p class="m-0 w-full text-ink t-caption" data-node="74:759" data-node-m="74:4193"><em>{disclaimer}</em></p>
      <ArrowLink href={ROUTES.results} class="min-h-[44px] lg:min-h-0" labelClass="whitespace-nowrap tm-body-strong lg:font-medium lg:text-[15px] lg:leading-[20px]" node="74:760" nodeM="74:4194">More claim results</ArrowLink>
    </div>
  </div>
</section>
