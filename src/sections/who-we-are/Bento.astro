---
// S4 The firm, as a team: bento (signature). Desktop 128:4513, mobile 128:6812.
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import Pic from './Pic.astro';
import CropMarks from './CropMarks.astro';
import Ruler from './Ruler.astro';
---
<section class="relative bg-white min-h-[872px] lg:min-h-[944px]" data-node="128:4513" data-node-m="128:6812">
  <div class="relative max-w-[1280px] mx-auto px-[20px] lg:px-[80px] pt-[56px] pb-[56px] lg:pt-[96px] lg:pb-[120px]">
    <div class="flex items-start gap-[18px] lg:gap-[24px]">
      <p class="m-0 w-max tm-label lg:t-label lg:text-[15px] lg:tracking-[0.3px] text-navy lg:text-royal whitespace-nowrap" data-node="128:4514" data-node-m="128:6813">§ 03</p>
      <span aria-hidden="true" class="block flex-1 h-px bg-line lg:bg-navy/35 mt-[7px] lg:mt-[9px]" data-node="128:4515" data-node-m="128:6814"></span>
    </div>

    <div class="relative mt-[24px] lg:mt-[30px] grid gap-[8px] grid-cols-[minmax(0,1fr)_minmax(0,1fr)] grid-rows-[208px_144px_208px_136px] lg:grid-cols-[minmax(0,360fr)_minmax(0,448fr)_minmax(0,264fr)] lg:grid-rows-[400px_24px_40px_24px_192px] lg:gap-x-[24px] lg:gap-y-0">
      <!-- estimator photo -->
      <div class="relative row-span-2 lg:row-span-3 lg:row-start-1 lg:col-start-1">
        <Pic node="128:4516" nodeM="128:6815" alt="An estimator, seen from behind, holds a laser meter to a charred beam between stripped studs." class="w-full h-full object-cover" dataNode="128:4516" dataNodeM="128:6815" />
        <CropMarks corners="tl bl" class="absolute -left-[8px] -top-[8px] w-[16px] -bottom-[8px] lg:-left-[12px] lg:-top-[12px] lg:-bottom-[12px]" node="128:4522" nodeM="128:6820" />
      </div>
      <!-- A full team (navy) -->
      <div class="relative overflow-hidden bg-navy text-white lg:col-start-2 lg:row-start-3 lg:row-span-3" data-node="128:4529" data-node-m="128:6821">
        <span aria-hidden="true" class="absolute left-[80px] top-[-10px] lg:left-[248px] lg:top-[-40px] opacity-[.053] pointer-events-none">
          <Logo variant="mark-white" bare width={181.2} height={220} class="lg:hidden" label="" />
          <Logo variant="mark-white" bare width={247.09} height={300} class="hidden lg:block" label="" />
        </span>
        <p class="absolute left-[16px] top-[16px] lg:left-[32px] lg:top-[36px] m-0 tm-label lg:t-label lg:text-[15px] lg:tracking-[0.3px] whitespace-nowrap" data-node="128:4535" data-node-m="128:6827">§ 02.2</p>
        <p class="absolute left-[16px] top-[120px] w-[139px] max-w-[calc(100%-32px)] lg:max-w-none lg:left-[32px] lg:top-[156px] lg:w-[384px] m-0 font-display font-bold text-[34px] leading-[36px] tracking-[-0.85px] lg:t-display-l lg:text-[clamp(48px,5vw,64px)] lg:leading-[1.0625em]" data-node="128:4536" data-node-m="128:6828">A full team.</p>
      </div>
      <!-- No Conflict of Interest -->
      <div class="relative bg-white border border-line lg:border-navy lg:col-start-1 lg:row-start-5" data-node="128:4523" data-node-m="128:6829">
        <Icon name="shield" size={32} class="absolute left-[15px] top-[15px] lg:left-[31px] lg:top-[31px] text-royal" />
        <p class="absolute right-[16px] top-[19px] lg:right-[30px] lg:top-[35px] m-0 tm-label lg:t-label lg:text-[15px] lg:tracking-[0.3px] text-navy lg:text-royal whitespace-nowrap" data-node="128:4527" data-node-m="128:6833">§ 04</p>
        <p class="absolute left-[15px] top-[71px] w-[139px] lg:left-[31px] lg:top-[111px] lg:w-[296px] max-w-[calc(100%-30px)] m-0 tm-h3 lg:t-h3 text-navy" data-node="128:4528" data-node-m="128:6834">No Conflict of Interest.</p>
      </div>
      <!-- inventory photo -->
      <div class="col-span-2 lg:col-span-2 lg:col-start-2 lg:row-start-1">
        <Pic node="128:4517" nodeM="128:6835" alt="Gloved hands photograph a soot-covered vase beside numbered inventory tags." class="w-full h-full object-cover" dataNode="128:4517" dataNodeM="128:6835" />
      </div>
      <!-- Builder's scope -->
      <div class="relative col-span-2 bg-paper lg:col-span-1 lg:col-start-3 lg:row-start-3 lg:row-span-3" data-node="128:4537" data-node-m="128:6836">
        <span class="absolute left-[20px] top-[24px] lg:left-[24px] flex items-center justify-center w-[48px] h-[48px] rounded-full border border-navy text-navy" data-node="128:4538" data-node-m="128:6837"><Icon name="ruler" size={24} /></span>
        <p class="absolute left-[84px] top-[24px] lg:left-[24px] lg:top-[134px] m-0 tm-h3 lg:t-h3 text-navy whitespace-nowrap w-[250px] lg:w-[216px]" data-node="128:4542" data-node-m="128:6841">Builder's scope.</p>
        <p class="absolute left-[84px] top-[56px] w-[250px] max-w-[calc(100%-100px)] lg:max-w-none lg:left-[24px] lg:top-[176px] lg:w-[192px] m-0 tm-body lg:t-body text-ink" data-node="128:4543" data-node-m="128:6842">Trade by trade, to current code.</p>
        <Ruler dir="up" color="rgba(8,29,94,.35)" class="lg:hidden absolute left-0 right-0 bottom-0 h-[12px]" nodeM="128:6888" />
      </div>
    </div>
  </div>
</section>
