---
// Detail / Dimension line (71:527): tick, rule, caption, rule, tick. Rules/ticks royal; caption colour via labelClass.
interface Props { label: string; class?: string; labelClass?: string; lineClass?: string; node?: string; nodeM?: string }
const { label, class: cls = '', labelClass = 'text-royal', lineClass = 'bg-royal', node, nodeM } = Astro.props;
---
<div aria-hidden="true" class:list={['flex items-center gap-[8px] h-[16px]', cls]} data-node={node} data-node-m={nodeM}>
  <span class:list={['block w-px h-[12px] shrink-0', lineClass]}></span>
  <span class:list={['block flex-1 min-w-px h-px', lineClass]}></span>
  <span class:list={['t-caption whitespace-nowrap', labelClass]}>{label}</span>
  <span class:list={['block flex-1 min-w-px h-px', lineClass]}></span>
  <span class:list={['block w-px h-[12px] shrink-0', lineClass]}></span>
</div>
