---
// S1 Hero, split screen. Desktop 128:3460, mobile 128:6371.
import Button from '../../components/Button.astro';
import Pic from './Pic.astro';
import CropMarks from './CropMarks.astro';
import DimLine from './DimLine.astro';
import Ruler from './Ruler.astro';
import { PHONE_DISPLAY, PHONE_TEL, ROUTES } from '../../data/site';
---
<section aria-labelledby="wwa-title" class="relative bg-paper overflow-hidden" data-node="128:3460" data-node-m="128:6371">
  <div class="relative max-w-[1280px] mx-auto min-h-[720px] lg:min-h-[800px] px-[20px] lg:px-[80px] pt-[252px] pb-[48px] lg:pt-[88px] lg:pb-[96px]">
    <!-- mobile: eyebrow stack, vertical ruler, photo, crop marks, dimension line -->
    <span aria-hidden="true" class="lg:hidden absolute left-[20px] top-[24px] w-[40px] h-px bg-navy" data-node-m="128:6378"></span>
    <p class="lg:hidden absolute left-[20px] top-[36px] m-0 tm-label text-navy whitespace-nowrap" data-node-m="128:6379">Who We Are</p>
    <Ruler dir="v" color="rgba(8,29,94,.45)" class="lg:hidden absolute left-[20px] top-[88px] w-[12px] h-[120px]" nodeM="128:6396" />
    <div class="absolute left-[112px] right-0 top-[16px] h-[192px] lg:right-0 lg:top-[40px] lg:left-[55%] lg:h-[704px] overflow-hidden">
      <Pic node="128:3475" nodeM="128:6372" priority alt="A house frame going back up after a fire, plans on a sawhorse, tape and laser meter in low sun." class="w-full h-full object-cover" dataNode="128:3475" dataNodeM="128:6372" />
    </div>
    <CropMarks corners="tl bl" class="absolute left-[104px] top-[8px] w-[16px] h-[208px] lg:left-[calc(55%-12px)] lg:top-[28px] lg:h-[728px]" node="128:3480" nodeM="128:6784" />
    <DimLine label="25 years as a developer and builder" class="absolute left-[112px] right-[20px] top-[220px] lg:left-[55%] lg:right-[40px] lg:top-[760px]" node="128:3481" nodeM="128:6397" />

    <div class="relative lg:w-[min(600px,calc(55vw-104px))]">
      <p class="hidden lg:flex items-center gap-[16px] m-0 t-label text-ink whitespace-nowrap w-max" data-node="128:3461">
        <span aria-hidden="true" class="block w-[40px] h-[1.5px] bg-royal"></span><span>Who We Are</span>
      </p>
      <h1 id="wwa-title" class="m-0 tm-display text-navy lg:mt-[22px] lg:-ml-[4px] lg:w-full lg:text-[clamp(72px,7.5vw,96px)] lg:leading-[0.9584em] lg:tracking-[-0.025em]" data-node="128:3464" data-node-m="128:6403">Same Experience.<br /> A New Way.</h1>
      <p class="m-0 mt-[16px] tm-lead text-ink lg:mt-[40px] lg:w-[520px] lg:max-w-full lg:text-[24px] lg:leading-[36px]" data-node="128:3465" data-node-m="128:6404">We left a legacy firm to build something leaner, more responsive, and 100% focused on you, without the bureaucracy that slows claims down.</p>
      <div class="mt-[24px] flex flex-col gap-[12px] lg:mt-[48px] lg:flex-row lg:flex-wrap lg:gap-[16px] lg:w-max lg:max-w-full" data-node="128:3466">
        <Button href={ROUTES.freeClaimReview} class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[253px]" data-node="128:3467" data-node-m="128:6405">Schedule a Free Review</Button>
        <Button href={PHONE_TEL} variant="outline" icon="phone" class="h-[56px] w-full lg:h-[52px] lg:w-auto lg:min-w-[235px]" data-node="128:3471" data-node-m="128:6409">Call {PHONE_DISPLAY}</Button>
      </div>
    </div>
  </div>
</section>
